(def selfhost/effect-bridge::starts-with?
  (fn (value)
    (fn (prefix)
      (let ((value-bytes (core/str::to-utf8 value)))
        (let ((prefix-bytes (core/str::to-utf8 prefix)))
          (let ((value-len (core/bytes::len value-bytes)))
            (let ((prefix-len (core/bytes::len prefix-bytes)))
              (if ((core/int::lt? value-len) prefix-len)
                false
                ((core/eq? (((core/bytes::slice value-bytes) 0) prefix-len))
                  prefix-bytes)))))))))

(def selfhost/effect-bridge::strip-digest-prefix
  (fn (value)
    (if
      (if ((selfhost/effect-bridge::starts-with? value) "sha256:")
        true
        ((selfhost/effect-bridge::starts-with? value) "SHA256:"))
      (let ((bytes (core/str::to-utf8 value)))
        (core/str::from-utf8
          (((core/bytes::slice bytes) 7) ((core/int::sub (core/bytes::len bytes)) 7))))
      value)))

(def selfhost/effect-bridge::input-valid?
  (fn (value)
    (if
      ((selfhost/effect-policy::exact-map? value)
        [:allowlist :args :command :digest :transport :wasi-profile])
      (if (selfhost/effect-network::list-input?
            ((core/map::get value) (quote :allowlist)))
        (if (selfhost/effect-network::list-input?
              ((core/map::get value) (quote :args)))
          (if (selfhost/effect-network::optional-string-input?
              ((core/map::get value) (quote :command)))
            (if (selfhost/effect-network::optional-string-input?
                  ((core/map::get value) (quote :digest)))
              (if (selfhost/effect-network::optional-string-input?
                    ((core/map::get value) (quote :transport)))
                (selfhost/effect-network::optional-bool-input?
                  ((core/map::get value) (quote :wasi-profile)))
                false)
              false)
            false)
          false)
        false)
      false)))

(def selfhost/effect-bridge::allowlist-policy-loop
  (fn (values)
    (fn (index)
      (fn (out)
        (if ((core/int::eq? index) (core/vec::len values))
          {:status (quote :valid) :values out}
          (let ((value ((core/vec::get values) index)))
            (if (selfhost/policy::str? value)
              (let ((trimmed (selfhost/policy::trim value)))
                (if (selfhost/policy::non-empty-str? trimmed)
                  (((selfhost/effect-bridge::allowlist-policy-loop values)
                     ((core/int::add index) 1))
                    ((core/vec::push out) trimmed))
                  {:status (quote :empty-entry) :values nil}))
              {:status (quote :invalid-entry) :values nil})))))))

(def selfhost/effect-bridge::allowlist-policy
  (fn (raw)
    (if (selfhost/policy::nil? raw)
      {:status (quote :absent) :values nil}
      (if (selfhost/policy::vec? raw)
        (((selfhost/effect-bridge::allowlist-policy-loop raw) 0) [])
        {:status (quote :invalid-type) :values nil}))))

(def selfhost/effect-bridge::args-policy-loop
  (fn (values)
    (fn (index)
      (fn (out)
        (if ((core/int::eq? index) (core/vec::len values))
          out
          (let ((value ((core/vec::get values) index)))
            (((selfhost/effect-bridge::args-policy-loop values)
               ((core/int::add index) 1))
              (if (selfhost/policy::str? value) ((core/vec::push out) value) out))))))))

(def selfhost/effect-bridge::args-policy
  (fn (raw)
    (if (selfhost/policy::vec? raw)
      (((selfhost/effect-bridge::args-policy-loop raw) 0) [])
      [])))

(def selfhost/effect-bridge::command-policy
  (fn (raw) (if (selfhost/policy::str? raw) raw nil)))

(def selfhost/effect-bridge::transport-policy
  (fn (raw)
    (if (selfhost/policy::str? raw)
      (let ((value (selfhost/policy::trim raw)))
        (if (selfhost/policy::non-empty-str? value)
          (if ((core/eq? value) "spawn-per-op")
            {:status (quote :spawn-per-op) :value nil}
            (if ((core/eq? value) "persistent-stdio")
              {:status (quote :persistent-stdio) :value nil}
              {:status (quote :invalid) :value value}))
          {:status (quote :spawn-per-op) :value nil}))
      {:status (quote :spawn-per-op) :value nil})))

(def selfhost/effect-bridge::wasi-profile-policy
  (fn (raw)
    (if ((core/sym::eq? (core/data::tag raw)) (quote :bool)) raw false)))

(def selfhost/effect-bridge::family-requires-pin?
  (fn (op)
    (if ((selfhost/effect-bridge::starts-with? op) "host/plugin::")
      true
      (if ((selfhost/effect-bridge::starts-with? op) "host/ffi::")
        true
        ((selfhost/effect-bridge::starts-with? op) "editor/")))))

(def selfhost/effect-bridge::state-status?
  (fn (state)
    (fn (status)
      ((core/sym::eq? ((core/map::get state) (quote :status))) status))))

(def selfhost/effect-bridge::digest-policy
  (fn (raw)
    (let ((state (selfhost/effect-network::string-policy raw)))
      (if ((selfhost/effect-bridge::state-status? state) (quote :valid))
        (let
          ((digest
            (selfhost/effect-bridge::strip-digest-prefix
              ((core/map::get state) (quote :value)))))
          (if (selfhost/effect-ffi::hex64? digest)
            {
              :status (quote :valid)
              :value (selfhost/effect-crypto::ascii-lower digest)}
            {:status (quote :invalid-digest) :value nil}))
        state))))

(def selfhost/effect-bridge::pin-required?
  (fn (op)
    (fn (bridge)
      (if (selfhost/effect-bridge::family-requires-pin? op)
        (let
          ((command
              (selfhost/effect-network::string-policy
                ((core/map::get bridge) (quote :command))))
            (wasi
              (selfhost/effect-network::bool-policy
                ((core/map::get bridge) (quote :wasi-profile)))))
          (if ((selfhost/effect-bridge::state-status? command) (quote :valid))
            (if ((selfhost/effect-bridge::state-status? wasi) (quote :valid))
              (if ((core/map::get wasi) (quote :value)) false true)
              true)
            false))
        false))))

(def selfhost/effect-bridge::policy
  (fn (op)
    (fn (override)
      (let
        ((bridge
          (if (selfhost/policy::nil? override)
            {:allowlist nil :args nil :command nil :digest nil :transport nil :wasi-profile nil}
            ((core/map::get override) (quote :bridge-identity-policy)))))
        {
          :allowlist
            (selfhost/effect-bridge::allowlist-policy
              ((core/map::get bridge) (quote :allowlist)))
          :args
            (selfhost/effect-bridge::args-policy
              ((core/map::get bridge) (quote :args)))
          :command
            (selfhost/effect-bridge::command-policy
              ((core/map::get bridge) (quote :command)))
          :digest
            (selfhost/effect-bridge::digest-policy
              ((core/map::get bridge) (quote :digest)))
          :pin-required ((selfhost/effect-bridge::pin-required? op) bridge)
          :transport
            (selfhost/effect-bridge::transport-policy
              ((core/map::get bridge) (quote :transport)))
          :wasi-profile
            (selfhost/effect-bridge::wasi-profile-policy
              ((core/map::get bridge) (quote :wasi-profile)))}))))
