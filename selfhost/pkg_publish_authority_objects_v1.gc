(def selfhost/pkg-publish-authority::bytes-hash
  (fn (bytes)
    (let ((digest (core/crypto::blake3 bytes)))
      (if (core/error::is? digest) nil (core/bytes::to-hex digest)))))

(def selfhost/pkg-publish-authority::canonical-bytes
  (fn (term)
    (let ((printed (selfhost/printer::print-term term)))
      (if (core/error::is? printed)
        nil
        (let ((bytes (core/str::to-utf8 printed))) (if (core/error::is? bytes) nil bytes))))))

(def selfhost/pkg-publish-authority::object-valid?
  (fn (object)
    (fn (expected-h)
      (if ((selfhost/store-authority::exact-map? object) [:bytes :h :term])
        (let
          ((bytes ((selfhost/pkg-publish-authority::field object) (quote :bytes)))
            (hash ((selfhost/pkg-publish-authority::field object) (quote :h)))
            (term ((selfhost/pkg-publish-authority::field object) (quote :term))))
          (if (selfhost/pkg-publish-authority::bytes? bytes)
            (if (selfhost/store-authority::hash? hash)
              (if ((core/eq? hash) expected-h)
                (if ((core/eq? (selfhost/pkg-publish-authority::bytes-hash bytes)) hash)
                  ((core/eq? (selfhost/pkg-publish-authority::canonical-bytes term)) bytes)
                  false)
                false)
              false)
            false))
        false))))

(def selfhost/pkg-publish-authority::objects-valid-loop?
  (fn (objects)
    (fn (expected)
      (fn (index)
        (if ((core/int::eq? index) (core/vec::len expected))
          true
          (if
            ((selfhost/pkg-publish-authority::object-valid? ((core/vec::get objects) index))
              ((core/vec::get expected) index))
