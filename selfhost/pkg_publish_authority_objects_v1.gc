      (let
        ((type ((selfhost/pkg-publish-authority::field term) (quote :type)))
          (version ((selfhost/pkg-publish-authority::field term) (quote :v)))
          (kind ((selfhost/pkg-publish-authority::field term) (quote :kind))))
        (if
          (if (selfhost/pkg-publish-authority::sym? type)
            ((core/sym::eq? type) (quote :vcs/evidence))
            false)
          (if (if (selfhost/pkg-publish-authority::int? version) ((core/int::eq? version) 1) false)
            (if (selfhost/pkg-publish-authority::sym? kind)
              (if
                ((selfhost/pkg-publish-authority::optional-evidence-hashes-valid? term)
                  (quote :inputs))
