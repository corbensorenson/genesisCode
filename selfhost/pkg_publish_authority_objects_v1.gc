(def selfhost/pkg-publish-authority::evidence-scan-loop
  (fn (objects)
    (fn (index)
      (fn (kinds)
        (fn (requirements)
          (fn (qualifications)
            (if ((core/int::eq? index) (core/vec::len objects))
              (selfhost/pkg-publish-authority::internal-ok
                {
                  :kinds kinds
                  :qualifications qualifications
                  :requirements requirements})
              (let
                ((term ((selfhost/pkg-publish-authority::field ((core/vec::get objects) index)) (quote :term))))
                (if (selfhost/pkg-publish-authority::evidence-valid? term)
                  (let
                    (
                      (kind
                        (selfhost/pkg-publish-policy::normalize-kind
                          ((selfhost/pkg-publish-authority::field term) (quote :kind)))))
                    (
                      (
                        (((selfhost/pkg-publish-authority::evidence-scan-loop objects) ((core/int::add index) 1))
                          (((core/map::put kinds) kind) true))
                        (if ((core/eq? kind) ":requirements-trace")
                          ((core/vec::push requirements) term)
                          requirements))
                      (if ((core/eq? kind) ":tool-qualification")
                        ((core/vec::push qualifications) term)
                        qualifications)))
                  (selfhost/pkg-publish-authority::internal-bad "core/pkg/bad-evidence"))))))))))

(def selfhost/pkg-publish-authority::evidence-scan
  (fn (objects) (((((selfhost/pkg-publish-authority::evidence-scan-loop objects) 0) {}) []) [])))

