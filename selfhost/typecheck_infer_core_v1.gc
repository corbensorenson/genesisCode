(def selfhost/typecheck::infer-fn
  (fn (items)
    (fn (env)
      (fn (expected)
        (fn (session)
          (if ((core/int::lt? (core/vec::len items)) 3)
            ((selfhost/typecheck::infer-error session)
              "(fn (x) body...) expects at least 2 arguments")
            (let ((params (selfhost/typecheck::list-items-or-nil ((core/vec::get items) 1))))
              (if (selfhost/typecheck::vec? params)
                (let ((validated (selfhost/typecheck::validate-fn-params params)))
                  (if (selfhost/typecheck::result-ok? validated)
                    ((((((selfhost/typecheck::infer-fn-params
                           ((core/map::get validated) (quote :value)))
                          0)
                         (selfhost/typecheck::fn-body-term items))
                        env)
                       expected)
                      session)
                    ((selfhost/typecheck::infer-error session)
                      ((core/map::get validated) (quote :error)))))
                ((selfhost/typecheck::infer-error session)
                  ((selfhost/typecheck::str2 "fn params must be a list of symbols, got ")
                    (selfhost/typecheck::term-str ((core/vec::get items) 1))))))))))))

(def selfhost/typecheck::validate-fn-params
  (fn (params)
    (if ((core/int::eq? (core/vec::len params)) 0)
      (selfhost/typecheck::err "fn must have at least 1 param")
      ((((selfhost/typecheck::validate-fn-params-loop params) (core/vec::len params)) 0) {}))))

(def selfhost/typecheck::validate-fn-params-loop
  (fn (params)
    (fn (n)
      (fn (i)
        (fn (seen)
          (if ((core/int::eq? i) n)
            (selfhost/typecheck::ok params)
            (let ((name ((core/vec::get params) i)))
              (if (selfhost/typecheck::sym? name)
                (if ((selfhost/typecheck::set-has? seen) name)
                  (selfhost/typecheck::err
                    ((selfhost/typecheck::str2 "(fn ...) duplicate parameter: ")
                      (selfhost/typecheck::symbol-str name)))
                  ((((selfhost/typecheck::validate-fn-params-loop params) n)
                     ((core/int::add i) 1))
                    ((selfhost/typecheck::set-add seen) name)))
                (selfhost/typecheck::err "(fn ...) parameters must be symbols")))))))))

(def selfhost/typecheck::infer-fn-params
  (fn (params)
    (fn (index)
      (fn (body)
        (fn (env)
          (fn (expected)
            (fn (session)
              (let
                ((name ((core/vec::get params) index))
                  (expected-param
                    (if
                      (if (selfhost/typecheck::map? expected)
                        ((core/sym::eq? (selfhost/typecheck::ty-tag expected)) (quote :fn))
                        false)
                      ((core/map::get expected) (quote :param))
                      selfhost/typecheck::ty-any))
                  (expected-ret
                    (if
                      (if (selfhost/typecheck::map? expected)
                        ((core/sym::eq? (selfhost/typecheck::ty-tag expected)) (quote :fn))
                        false)
                      ((core/map::get expected) (quote :ret))
                      nil)))
                (let ((env2 (((core/map::put env) name) expected-param)))
                  (let
                    ((result
                       (if ((core/int::eq? ((core/int::add index) 1)) (core/vec::len params))
                         ((((selfhost/typecheck::infer-term-with-expected body) env2) expected-ret)
                           session)
                         ((((((selfhost/typecheck::infer-fn-params params)
                                ((core/int::add index) 1))
                               body)
                              env2)
                             expected-ret)
                            session)))
                      (effects
                        (((selfhost/typecheck::effects-in-term-with-expected body) env2)
                          expected-ret)))
                    ((selfhost/typecheck::infer-result
                       (((selfhost/typecheck::ty-fn expected-param)
                          ((core/map::get result) (quote :type)))
                         ((selfhost/typecheck::eff-row
                            ((core/map::get effects) (quote :ops)))
                           (if ((core/map::get effects) (quote :unknown))
                             (quote :any)
                             (quote :closed)))))
                      ((core/map::get result) (quote :session)))))))))))))

(def selfhost/typecheck::infer-if
  (fn (items)
    (fn (env)
      (fn (session)
        (if ((core/int::eq? (core/vec::len items)) 4)
          (let ((condition (((selfhost/typecheck::infer-term ((core/vec::get items) 1)) env) session)))
            (let
              ((then-result
                 (((selfhost/typecheck::infer-term ((core/vec::get items) 2)) env)
                   ((core/map::get condition) (quote :session)))))
              (let
                ((else-result
                   (((selfhost/typecheck::infer-term ((core/vec::get items) 3)) env)
                     ((core/map::get then-result) (quote :session)))))
                ((selfhost/typecheck::infer-result
                   ((selfhost/typecheck::join-types
                      ((core/map::get then-result) (quote :type)))
                     ((core/map::get else-result) (quote :type))))
                  ((core/map::get else-result) (quote :session))))))
          ((selfhost/typecheck::infer-error session)
            "(if c t e) expects exactly 3 arguments"))))))

(def selfhost/typecheck::join-types
  (fn (left)
    (fn (right) (if ((core/eq? left) right) left selfhost/typecheck::ty-any))))

