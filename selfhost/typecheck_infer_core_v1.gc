(def selfhost/typecheck::infer-result
  (fn (type) (fn (session) {:session session :type type})))

(def selfhost/typecheck::infer-error
  (fn (session)
    (fn (message)
      ((selfhost/typecheck::infer-result selfhost/typecheck::ty-any)
        ((selfhost/typecheck::session-error session) message)))))

(def selfhost/typecheck::env-with-prelude
  (fn (declared)
    (((core/map::put declared) (quote core/contract::genesis))
      ((selfhost/typecheck::ty-contract {}) (quote r)))))

(def selfhost/typecheck::effects-vec-to-set
  (fn (ops)
    ((((selfhost/typecheck::effects-vec-to-set-loop ops) (core/vec::len ops)) 0) {})))

(def selfhost/typecheck::effects-vec-to-set-loop
