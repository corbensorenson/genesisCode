    (fn (n)
      (fn (i)
        (fn (set)
          (if ((core/int::eq? i) n)
            set
            ((((selfhost/typecheck::effects-vec-to-set-loop ops) n) ((core/int::add i) 1))
              ((selfhost/typecheck::set-add set) ((core/vec::get ops) i)))))))))

(def selfhost/typecheck::infer-syntax-effects-term
  (fn (term)
    (let ((report (core/cli::infer-effects ((core/vec::push []) term))))
      ((selfhost/typecheck::eff-row
         (selfhost/typecheck::effects-vec-to-set
           ((core/map::get report) (quote :ops))))
        (if ((core/map::get report) (quote :unknown)) (quote :any) (quote :closed))))))

(def selfhost/typecheck::infer-module-types
  (fn (forms)
    (fn (declared)
      (let ((env (selfhost/typecheck::env-with-prelude declared)))
        (((((selfhost/typecheck::infer-module-types-loop forms) (core/vec::len forms)) 0)
           {:defs {} :env env})
          selfhost/typecheck::session-empty)))))

(def selfhost/typecheck::infer-module-types-loop
  (fn (forms)
    (fn (n)
      (fn (i)
        (fn (state)
          (fn (session)
            (if ((core/int::eq? i) n)
              {:defs ((core/map::get state) (quote :defs))
                :env ((core/map::get state) (quote :env))
                :session session}
              (let ((parsed (selfhost/typecheck::parse-def-term ((core/vec::get forms) i))))
                (if (selfhost/typecheck::nil? parsed)
                  (((((selfhost/typecheck::infer-module-types-loop forms) n)
                     ((core/int::add i) 1))
                    state)
                   session)
                  (let
                    ((name ((core/map::get parsed) (quote :name)))
                      (expr ((core/map::get parsed) (quote :expr)))
                      (env ((core/map::get state) (quote :env))))
                    (let
                      ((inferred
                         (((selfhost/typecheck::infer-term-with-expected expr) env)
                           ((core/map::get env) name))
                         ))
                      (let ((result (inferred session)))
                        (((((selfhost/typecheck::infer-module-types-loop forms) n)
                           ((core/int::add i) 1))
                          {:defs
                             (((core/map::put ((core/map::get state) (quote :defs))) name)
                               ((core/map::get result) (quote :type)))
                            :env
                              (((core/map::put env) name)
                                ((core/map::get result) (quote :type)))})
                         ((core/map::get result) (quote :session)))))))))))))))

(def selfhost/typecheck::parse-def-term
  (fn (term)
    (let ((items (selfhost/typecheck::list-items-or-nil term)))
      (if (selfhost/typecheck::vec? items)
        (if ((core/int::eq? (core/vec::len items)) 3)
          (let ((head ((core/vec::get items) 0)) (name ((core/vec::get items) 1)))
            (if
              (if (selfhost/typecheck::sym? head)
                (if ((core/sym::eq? head) (quote def)) (selfhost/typecheck::sym? name) false)
                false)
              {:expr ((core/vec::get items) 2) :name name}
              nil))
          nil)
        nil))))

(def selfhost/typecheck::infer-term
  (fn (term)
    (fn (env)
      (fn (session)
        (let ((tag (core/data::tag term)))
          (if ((core/sym::eq? tag) (quote :nil))
            ((selfhost/typecheck::infer-result selfhost/typecheck::ty-nil) session)
            (if ((core/sym::eq? tag) (quote :bool))
              ((selfhost/typecheck::infer-result selfhost/typecheck::ty-bool) session)
              (if ((core/sym::eq? tag) (quote :int))
                ((selfhost/typecheck::infer-result selfhost/typecheck::ty-int) session)
                (if ((core/sym::eq? tag) (quote :str))
                  ((selfhost/typecheck::infer-result selfhost/typecheck::ty-str) session)
                  (if ((core/sym::eq? tag) (quote :bytes))
                    ((selfhost/typecheck::infer-result selfhost/typecheck::ty-bytes) session)
                    (if ((core/sym::eq? tag) (quote :sym))
                      (let ((found ((core/map::get env) term)))
                        ((selfhost/typecheck::infer-result
                           (if (selfhost/typecheck::nil? found)
                             selfhost/typecheck::ty-any
                             found))
                          session))
                      (if ((core/sym::eq? tag) (quote :vec))
                        ((selfhost/typecheck::infer-result selfhost/typecheck::ty-any) session)
                        (if ((core/sym::eq? tag) (quote :map))
                          (((selfhost/typecheck::infer-map-literal term) env) session)
                          (if ((core/sym::eq? tag) (quote :pair))
                            (((selfhost/typecheck::infer-list-form term) env) session)
                            ((selfhost/typecheck::infer-result selfhost/typecheck::ty-any)
                              session)))))))))))))))

(def selfhost/typecheck::infer-term-with-expected
  (fn (term)
    (fn (env)
      (fn (expected)
        (fn (session)
          (let ((items (selfhost/typecheck::list-items-or-nil term)))
            (if (selfhost/typecheck::vec? items)
              (if ((core/int::lt? 0) (core/vec::len items))
                (let ((head ((core/vec::get items) 0)))
                  (if
                    (if (selfhost/typecheck::sym? head)
                      ((core/sym::eq? head) (quote fn))
                      false)
                    ((((selfhost/typecheck::infer-fn items) env) expected) session)
                    (((selfhost/typecheck::infer-term term) env) session)))
                (((selfhost/typecheck::infer-term term) env) session))
              (((selfhost/typecheck::infer-term term) env) session))))))))

(def selfhost/typecheck::infer-map-literal
  (fn (map-term)
    (fn (env)
      (fn (session)
        (let ((entries (core/map::entries map-term)))
          (((((selfhost/typecheck::infer-map-literal-loop entries) env)
              (core/vec::len entries))
             0)
            {:fields {} :session session :tail (quote :closed)}))))))

(def selfhost/typecheck::infer-map-literal-loop
  (fn (entries)
    (fn (env)
      (fn (n)
        (fn (i)
          (fn (state)
            (if ((core/int::eq? i) n)
              ((selfhost/typecheck::infer-result
                 ((selfhost/typecheck::ty-rec ((core/map::get state) (quote :fields)))
                   ((core/map::get state) (quote :tail))))
                ((core/map::get state) (quote :session)))
              (let
                ((entry ((core/vec::get entries) i))
                  (key ((core/vec::get ((core/vec::get entries) i)) 0))
                  (value ((core/vec::get ((core/vec::get entries) i)) 1)))
                (let ((inferred (((selfhost/typecheck::infer-term value) env)
                                  ((core/map::get state) (quote :session)))))
                  (let
                    ((label-candidate
                       (if (selfhost/typecheck::sym? key)
                         key
                         (if (selfhost/typecheck::str? key) (core/sym::from-str key) nil))))
                    (let
                      ((label
                         (if (core/error::is? label-candidate) nil label-candidate)))
                    (((((selfhost/typecheck::infer-map-literal-loop entries) env) n)
                       ((core/int::add i) 1))
                      {:fields
                         (if (selfhost/typecheck::nil? label)
                           ((core/map::get state) (quote :fields))
                           (((core/map::put ((core/map::get state) (quote :fields))) label)
                             ((core/map::get inferred) (quote :type))))
                        :session ((core/map::get inferred) (quote :session))
                        :tail
                          (if (selfhost/typecheck::nil? label)
                            (quote :any)
                            ((core/map::get state) (quote :tail)))}))))))))))))

(def selfhost/typecheck::infer-list-form
  (fn (term)
    (fn (env)
      (fn (session)
        (let ((items (core/pair::as-proper-list term)))
          (if (selfhost/typecheck::vec? items)
            (if ((core/int::eq? (core/vec::len items)) 0)
              ((selfhost/typecheck::infer-result selfhost/typecheck::ty-nil) session)
              (let ((head ((core/vec::get items) 0)))
                (if (selfhost/typecheck::sym? head)
                  ((((selfhost/typecheck::infer-special-or-app head) items) env) session)
                  (let ((flat (core/cli::flatten-app term)))
                    (if (selfhost/typecheck::map? flat)
                      ((((selfhost/typecheck::infer-app
                           ((core/map::get flat) (quote :head)))
                          ((core/map::get flat) (quote :args)))
                         env)
                        session)
                      ((selfhost/typecheck::infer-result selfhost/typecheck::ty-any) session))))))
            ((selfhost/typecheck::infer-error session)
              "improper list is not a valid expression")))))))

(def selfhost/typecheck::infer-special-or-app
  (fn (head)
    (fn (items)
      (fn (env)
        (fn (session)
          (if ((core/sym::eq? head) (quote quote))
            ((selfhost/typecheck::infer-result selfhost/typecheck::ty-any) session)
            (if ((core/sym::eq? head) (quote fn))
              ((((selfhost/typecheck::infer-fn items) env) nil) session)
              (if ((core/sym::eq? head) (quote if))
                (((selfhost/typecheck::infer-if items) env) session)
                (if ((core/sym::eq? head) (quote begin))
                  (((selfhost/typecheck::infer-begin items) env) session)
                  (if ((core/sym::eq? head) (quote let))
                    (((selfhost/typecheck::infer-let items) env) session)
                    (if ((core/sym::eq? head) (quote prim))
                      (((selfhost/typecheck::infer-prim items) env) session)
                      (if
                        (if ((core/sym::eq? head) (quote seal))
                          true
                          ((core/sym::eq? head) (quote unseal)))
                        (((((selfhost/typecheck::infer-terms-loop items) env)
                            (core/vec::len items))
                           1)
                          session)
                        (if ((core/sym::eq? head) (quote def))
                          (let
                            ((walked
                               (((((selfhost/typecheck::infer-terms-loop items) env)
                                   (core/vec::len items))
                                  1)
                                 session)))
                            ((selfhost/typecheck::infer-result selfhost/typecheck::ty-any)
                              ((core/map::get walked) (quote :session))))
                          (let ((flat (core/cli::flatten-app (selfhost/typecheck::list-from-vec items))))
                            (if (selfhost/typecheck::map? flat)
                              ((((selfhost/typecheck::infer-app
                                   ((core/map::get flat) (quote :head)))
                                  ((core/map::get flat) (quote :args)))
                                 env)
                                session)
                              ((selfhost/typecheck::infer-result selfhost/typecheck::ty-any)
                                session))))))))))))))))

(def selfhost/typecheck::infer-terms-loop
  (fn (items)
    (fn (env)
      (fn (n)
        (fn (i)
          (fn (session)
            (if ((core/int::eq? i) n)
              ((selfhost/typecheck::infer-result selfhost/typecheck::ty-any) session)
              (let ((result (((selfhost/typecheck::infer-term ((core/vec::get items) i)) env) session)))
                (((((selfhost/typecheck::infer-terms-loop items) env) n)
                   ((core/int::add i) 1))
                  ((core/map::get result) (quote :session)))))))))))

(def selfhost/typecheck::fn-body-term
  (fn (items)
    (if ((core/int::eq? (core/vec::len items)) 3)
      ((core/vec::get items) 2)
      (selfhost/typecheck::list-from-vec
        ((core/vec::push
