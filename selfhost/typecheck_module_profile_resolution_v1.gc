                  (import-owners ((core/map::get owners) import)))
                (if (selfhost/typecheck::map? import-owners)
                  (let ((indices (selfhost/typecheck::set-keys import-owners)))
                    (if ((core/int::eq? (core/vec::len indices)) 1)
                      (let ((owner ((core/vec::get indices) 0)))
                        (if ((core/int::eq? owner) consumer)
                          (((selfhost/typecheck::module-error-add errors) path)
                            ((selfhost/typecheck::str3 "local symbol "
                               (selfhost/typecheck::symbol-str import))
                              " must not be listed in :imports"))
                          (if
                            ((selfhost/typecheck::set-has?
                               ((core/map::get ((core/vec::get descriptors) owner))
                                 (quote :exports)))
                              import)
                            (if ((core/int::lt? consumer) owner)
                              (((selfhost/typecheck::module-error-add errors) path)
                                ((selfhost/typecheck::str4 "import "
                                   (selfhost/typecheck::symbol-str import))
                                  " resolves to later module "
                                  ((selfhost/typecheck::str2
                                     ((core/map::get ((core/vec::get modules) owner))
                                       (quote :path)))
                                    "; imports must target earlier manifest entries (cycles and forward imports are forbidden)")))
                              errors)
                            (((selfhost/typecheck::module-error-add errors) path)
                              ((selfhost/typecheck::str4 "import "
                                 (selfhost/typecheck::symbol-str import))
                                " is private to module "
                                ((core/map::get ((core/vec::get modules) owner))
                                  (quote :path))
                                "")))))
                      (((selfhost/typecheck::module-error-add errors) path)
                        ((selfhost/typecheck::str3 "import "
                           (selfhost/typecheck::symbol-str import))
                          " has ambiguous ownership"))))
                  (((selfhost/typecheck::module-error-add errors) path)
                    ((selfhost/typecheck::str3 "import "
                       (selfhost/typecheck::symbol-str import))
                      " has no owner in the supplied package closure")))))))))))

