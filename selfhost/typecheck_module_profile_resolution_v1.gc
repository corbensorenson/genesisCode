(def selfhost/typecheck::resolve-module-profile
  (fn (modules)
    (let
      ((active (selfhost/typecheck::module-profile-active? modules))
        (identities (selfhost/typecheck::module-identities modules))
        (order (selfhost/typecheck::module-paths modules)))
      (if active
        (let
          ((path-state (selfhost/typecheck::validate-module-paths modules)))
          (let
            ((errors0
               ((selfhost/typecheck::add-duplicate-path-errors
                  ((core/map::get path-state) (quote :paths)))
                 ((core/map::get path-state) (quote :errors))))
              (parsed (selfhost/typecheck::parse-module-descriptors modules)))
            (let
