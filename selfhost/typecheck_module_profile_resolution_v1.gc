                (owners
                  (selfhost/typecheck::build-definition-owners
                    ((core/map::get parsed) (quote :descriptors)))))
              (let
                ((errors1
                   (((selfhost/typecheck::validate-exports-defined modules)
                      descriptors)
                     ((selfhost/typecheck::merge-module-error-sets errors0)
                       ((core/map::get parsed) (quote :errors))))))
                (let
                  ((errors2
                     (((selfhost/typecheck::validate-definition-owners modules) owners)
                       errors1)))
                  (let
                    ((errors3
                       ((((selfhost/typecheck::validate-imports-and-references modules)
                           descriptors)
                          owners)
                         errors2)))
                    {:active true
                      :descriptors descriptors
                      :errors (selfhost/typecheck::module-errors-to-vectors errors3)
                      :identity
                        (if ((core/int::eq? (core/map::len errors3)) 0)
                          (((selfhost/typecheck::resolution-identity modules) descriptors)
                            identities)
                          nil)
                      :module-identities identities
                      :ok ((core/int::eq? (core/map::len errors3)) 0)
                      :resolution-order order}))))))
        {:active false
          :descriptors []
          :errors {}
          :identity nil
          :module-identities identities
          :ok true
          :resolution-order order}))))

