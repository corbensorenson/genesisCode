(def selfhost/replay::tag core/data::tag)

(def selfhost/replay::nil? core/list::is-nil?)

(def selfhost/replay::not (fn (value) (if value false true)))

(def selfhost/replay::map? (fn (value) ((core/sym::eq? (selfhost/replay::tag value)) (quote :map))))

(def selfhost/replay::int? (fn (value) ((core/sym::eq? (selfhost/replay::tag value)) (quote :int))))

(def selfhost/replay::str? (fn (value) ((core/sym::eq? (selfhost/replay::tag value)) (quote :str))))

