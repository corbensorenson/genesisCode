          "genesis/gc-authority-request-v0.1")
        (if ((core/int::eq? ((selfhost/gc-authority::field request) (quote :v))) 1)
          (let
            ((op ((selfhost/gc-authority::field request) (quote :op)))
              (payload ((selfhost/gc-authority::field request) (quote :payload))))
            (if (selfhost/gc-authority::sym? op)
              (if ((core/sym::eq? op) (quote :roots))
                ((selfhost/gc-authority::roots request) payload)
                (if ((core/sym::eq? op) (quote :artifact-edges))
                  ((selfhost/gc-authority::artifact-edges request) payload)
                  (if ((core/sym::eq? op) (quote :dead-plan))
                    ((selfhost/gc-authority::dead-plan request) payload)
                    (if ((core/sym::eq? op) (quote :pins-update))
                      ((selfhost/gc-authority::pins-update request) payload)
                      (if ((core/sym::eq? op) (quote :purge-plan))
                        ((selfhost/gc-authority::purge-plan request) payload)
                        ((selfhost/gc-authority::bad request) "unsupported gc authority operation"))))))
              ((selfhost/gc-authority::bad request) "gc authority operation must be a symbol")))
          ((selfhost/gc-authority::bad request) "gc authority request version mismatch"))
        ((selfhost/gc-authority::bad request) "gc authority request kind mismatch"))
      ((selfhost/gc-authority::bad request) "gc authority request fields mismatch"))))
