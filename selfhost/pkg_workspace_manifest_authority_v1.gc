; Request-bound production authority for structural workspace manifests.

(def selfhost/pkg-workspace-manifest::request-kind
  "genesis/pkg-workspace-manifest-authority-request-v0.1")

(def selfhost/pkg-workspace-manifest::result-kind
  "genesis/pkg-workspace-manifest-authority-result-v0.1")

(def selfhost/pkg-workspace-manifest::result
  (fn (request-h)
    (fn (ok)
      (fn (code)
        (fn (message)
          (fn (value)
            {
              :code code
              :kind selfhost/pkg-workspace-manifest::result-kind
              :message message
              :ok ok
              :request-h request-h
              :v 1
              :value value}))))))

(def selfhost/pkg-workspace-manifest::reject
  (fn (request-h)
    (fn (message)
      (((((selfhost/pkg-workspace-manifest::result request-h) false)
          "core/pkg/bad-workspace-manifest")
        message)
      nil))))

(def selfhost/pkg-workspace-manifest::accept
  (fn (request-h)
    (fn (value)
      (((((selfhost/pkg-workspace-manifest::result request-h) true) nil) nil) value))))

(def selfhost/pkg-workspace-manifest::request-valid?
  (fn (request)
    (if
      ((selfhost/pkg-lock-read::exact-map? request)
        [:document :kind :require-profile :selected-profile :source-h :v])
      (if
        (if (selfhost/pkg-lock-read::str? ((core/map::get request) (quote :kind)))
          ((core/eq? ((core/map::get request) (quote :kind)))
            selfhost/pkg-workspace-manifest::request-kind)
          false)
        (if
          (if (selfhost/pkg-lock-read::int? ((core/map::get request) (quote :v)))
            ((core/int::eq? ((core/map::get request) (quote :v))) 1)
            false)
          (if
            (((selfhost/pkg-scaffold::bounded-str?
                ((core/map::get request) (quote :selected-profile))) 1024))
            (if
              (selfhost/pkg-workspace-manifest::bool?
                ((core/map::get request) (quote :require-profile)))
              (selfhost/pkg-lock-ops::lower-hex64?
                ((core/map::get request) (quote :source-h)))
              false)
            false)
          false)
        false)
      false)))

(def core/pkg::workspace-manifest-authority
  (fn (request)
    (let ((request-h (selfhost/hash::hash-term request)))
      (if (selfhost/pkg-lock-read::map? request)
        (if (selfhost/pkg-workspace-manifest::request-valid? request)
          (let
            ((normalized
              (((selfhost/pkg-workspace-manifest::normalize
                  ((core/map::get request) (quote :document)))
                ((core/map::get request) (quote :selected-profile)))
                ((core/map::get request) (quote :require-profile)))))
            (if ((core/map::get normalized) (quote :ok))
              ((selfhost/pkg-workspace-manifest::accept request-h)
                (((core/map::put
                    ((core/map::get normalized) (quote :value)))
                  (quote :source-h))
                  ((core/map::get request) (quote :source-h))))
              ((selfhost/pkg-workspace-manifest::reject request-h)
                ((core/map::get normalized) (quote :message)))))
          ((selfhost/pkg-workspace-manifest::reject request-h)
            "workspace manifest request fields are invalid"))
        ((selfhost/pkg-workspace-manifest::reject request-h)
          "workspace manifest request must be map")))))
