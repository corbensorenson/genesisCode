                                      false)
                                    ((core/vec::push errors4)
                                      (
                                        ((selfhost/obligation::coverage-count-error "mcdc coverage missing condition independence on ")
                                          (core/vec::len mcdc-missing))
                                        " decision site(s)"))
                                    errors4)))
                              (let ((ok ((core/int::eq? (core/vec::len errors5)) 0)))
                                (let
                                  (
                                    (report0
                                      {
                                        :definition "exports minus (tests, property_tests)"
                                        :exports exports
                                        :kind "genesis/coverage-v0.2"
                                        :missing ((core/map::get export-state) (quote :missing))
                                        :ok ok
                                        :package package
                                        :profile profile
