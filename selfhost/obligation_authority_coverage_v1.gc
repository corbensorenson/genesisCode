                    "coverage requires unit tests (package.toml `tests` is empty)")
                  [])))
            (let
              (
                (errors1
                  (
                    (
                      (selfhost/obligation::coverage-effect-errors-loop
                        ((core/map::get inputs) (quote :missing-effect-logs)))
                      0)
                    errors0)))
              (let
                ((export-state ((((selfhost/obligation::coverage-exports-loop exports) 0) []) errors1)))
                (let
                  ((statement-state ((((selfhost/obligation::coverage-statements-loop statements) 0) []) [])))
                  (let
                    ((decision-state ((((((selfhost/obligation::coverage-decisions-loop decisions) 0) []) []) []) [])))
                    (let ((errors2 ((core/map::get export-state) (quote :errors))))
                      (let
                        ((statement-missing ((core/map::get statement-state) (quote :missing)))
                          (decision-missing
                            ((core/map::get decision-state) (quote :missing-decisions)))
                          (mcdc-missing ((core/map::get decision-state) (quote :missing-mcdc))))
                        (let
                          (
                            (errors3
                              (if
                                (if (selfhost/obligation::coverage-structural? profile)
                                  (if ((core/int::eq? (core/vec::len statement-missing)) 0)
                                    false
                                    true)
                                  false)
                                ((core/vec::push errors2)
                                  (
                                    ((selfhost/obligation::coverage-count-error "statement-site coverage missing ")
                                      (core/vec::len statement-missing))
                                    " site(s)"))
                                errors2)))
                          (let
                            (
                              (errors4
                                (if
                                  (if (selfhost/obligation::coverage-structural? profile)
                                    (if ((core/int::eq? (core/vec::len decision-missing)) 0)
                                      false
