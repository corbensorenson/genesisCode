(def selfhost/evidence-verify-package::evaluate
  (fn (request)
    (let
      ((facts ((selfhost/evidence-verify-package::field request) (quote :facts)))
        (store ((selfhost/evidence-verify-package::field request) (quote :store)))
        (acceptance ((selfhost/evidence-verify-package::field request) (quote :acceptance)))
        (acceptance-h ((selfhost/evidence-verify-package::field request) (quote :acceptance-h)))
        (policy ((selfhost/evidence-verify-package::field request) (quote :policy)))
        (signature-set ((selfhost/evidence-verify-package::field request) (quote :signature-set)))
        (signatures ((selfhost/evidence-verify-package::field request) (quote :signatures))))
      (let ((fact-errors (((selfhost/evidence-verify-package::facts-loop facts) 0) [])))
        (let ((store-errors (((selfhost/evidence-verify-package::store-loop store) 0) fact-errors)))
          (let
            ((acceptance-errors
                (if (((selfhost/evidence-verify-package::acceptance-valid? acceptance)
                        acceptance-h) store)
                  store-errors
                  ((selfhost/evidence-verify-package::push-error store-errors)
                    "evidence/acceptance-schema-or-reference"))))
            (let
              ((policy-result
                  (selfhost/evidence-verify-package::policy-evaluate
                    policy acceptance-h signature-set signatures acceptance-errors)))
              (let
                ((errors ((selfhost/evidence-verify-package::field policy-result) (quote :errors)))
                  (count ((selfhost/evidence-verify-package::field policy-result) (quote :count))))
                {
                  :checked
                    ((core/int::add (core/vec::len facts))
                      ((core/int::add (core/vec::len store)) (core/vec::len signatures)))
                  :errors errors
                  :valid-signatures count
                  :verified ((core/int::eq? (core/vec::len errors)) 0)}))))))))
