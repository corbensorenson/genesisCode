(def selfhost/effect-store-credential::valid
  (fn (auth-token)
    (fn (auth-token-env)
      (fn (basic-password)
        (fn (basic-password-env)
          (fn (basic-username)
            (fn (mtls-ca-pem)
              (fn (mtls-identity-pem)
                {
                  :basic-password-env
                    (if (selfhost/policy::str? basic-password-env) basic-password-env nil)
                  :basic-password-source
                    (if (selfhost/policy::str? basic-username)
                      (if (selfhost/effect-store-credential::present? basic-password)
                        (quote :inline)
                        (if (selfhost/policy::str? basic-password-env)
                          (quote :environment)
                          (quote :implicit-empty)))
                      (quote :none))
                  :basic-username basic-username
                  :bearer-env (if (selfhost/policy::str? auth-token-env) auth-token-env nil)
                  :bearer-source
                    (if (selfhost/effect-store-credential::present? auth-token)
                      (quote :inline)
                      (if (selfhost/policy::str? auth-token-env) (quote :environment) (quote :none)))
                  :mtls-ca-pem mtls-ca-pem
                  :mtls-identity-pem mtls-identity-pem
                  :status (quote :valid)}))))))))

(def selfhost/effect-store-credential::policy
  (fn (value)
    (let
      ((auth-token ((core/map::get value) (quote :auth-token)))
        (auth-token-env ((core/map::get value) (quote :auth-token-env)))
        (basic-password ((core/map::get value) (quote :basic-password)))
        (basic-password-env ((core/map::get value) (quote :basic-password-env)))
        (basic-username ((core/map::get value) (quote :basic-username)))
        (mtls-ca-pem ((core/map::get value) (quote :mtls-ca-pem)))
        (mtls-identity-pem ((core/map::get value) (quote :mtls-identity-pem))))
      (if (selfhost/effect-store-credential::invalid-type? auth-token)
        (selfhost/effect-store-credential::invalid (quote :auth-token-invalid-type))
        (if (selfhost/effect-store-credential::invalid-type? auth-token-env)
          (selfhost/effect-store-credential::invalid (quote :auth-token-env-invalid-type))
          (if (selfhost/effect-store-credential::invalid-type? basic-username)
            (selfhost/effect-store-credential::invalid (quote :basic-username-invalid-type))
            (if (selfhost/effect-store-credential::invalid-type? basic-password)
              (selfhost/effect-store-credential::invalid (quote :basic-password-invalid-type))
              (if (selfhost/effect-store-credential::invalid-type? basic-password-env)
                (selfhost/effect-store-credential::invalid (quote :basic-password-env-invalid-type))
                (if (selfhost/effect-store-credential::invalid-type? mtls-ca-pem)
                  (selfhost/effect-store-credential::invalid (quote :mtls-ca-pem-invalid-type))
                  (if (selfhost/effect-store-credential::invalid-type? mtls-identity-pem)
                    (selfhost/effect-store-credential::invalid
                      (quote :mtls-identity-pem-invalid-type))
                    (if
                      (if (selfhost/effect-store-credential::present? auth-token)
                        (selfhost/policy::str? auth-token-env)
                        false)
                      (selfhost/effect-store-credential::invalid (quote :auth-token-source-conflict))
                      (if
                        (if (selfhost/effect-store-credential::present? basic-password)
                          (selfhost/policy::str? basic-password-env)
                          false)
                        (selfhost/effect-store-credential::invalid
                          (quote :basic-password-source-conflict))
                        (if
                          (if
                            (if (selfhost/effect-store-credential::present? auth-token)
                              true
                              (selfhost/policy::str? auth-token-env))
                            (selfhost/policy::str? basic-username)
                            false)
                          (selfhost/effect-store-credential::invalid (quote :bearer-basic-conflict))
                          (if
                            (if (selfhost/policy::str? basic-username)
                              false
                              (if (selfhost/effect-store-credential::present? basic-password)
                                true
                                (selfhost/policy::str? basic-password-env)))
                            (selfhost/effect-store-credential::invalid
                              (quote :password-without-username))
                            (
                              (
                                (
                                  ((((selfhost/effect-store-credential::valid auth-token) auth-token-env) basic-password)
                                    basic-password-env)
                                  basic-username)
                                mtls-ca-pem)
                              mtls-identity-pem)))))))))))))))

