(def selfhost/effect-policy::task-resource-policy-valid?
  (fn (task)
    (if ((selfhost/effect-policy::exact-map? task)
          [:default-workers
           :max-queue
           :max-steps-per-task
           :max-tasks
           :max-time-ms-per-task
           :max-workers])
      (let ((default-workers ((core/map::get task) (quote :default-workers))))
        (if
