(def selfhost/effect-policy::exact-map?
  (fn (value)
    (fn (keys)
      (if (selfhost/policy::map? value)
        (if ((core/int::eq? (core/map::len value)) (core/vec::len keys))
          (((selfhost/effect-policy::map-has-keys-loop? value) keys) 0)
