(def selfhost/effect-policy::map-has-key-loop?
  (fn (entries)
    (fn (key)
      (fn (index)
        (if ((core/int::eq? index) (core/vec::len entries))
          false
          (let ((entry ((core/vec::get entries) index)))
            (if ((core/eq? ((core/vec::get entry) 0)) key)
              true
              (((selfhost/effect-policy::map-has-key-loop? entries) key)
                ((core/int::add index) 1)))))))))

(def selfhost/effect-policy::map-has-key?
  (fn (map)
    (fn (key)
      (((selfhost/effect-policy::map-has-key-loop? (core/map::entries map)) key) 0))))

(def selfhost/effect-policy::map-has-keys-loop?
  (fn (map)
    (fn (keys)
      (fn (index)
        (if ((core/int::eq? index) (core/vec::len keys))
