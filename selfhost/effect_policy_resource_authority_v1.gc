(def core/effects::resource-policy-authority
  (fn (request)
    (if ((selfhost/effect-policy::exact-map? request)
          [:available-workers :kind :log :refs :runtime :store :task :v])
      (let
        ((available-workers ((core/map::get request) (quote :available-workers)))
          (kind ((core/map::get request) (quote :kind)))
          (log ((core/map::get request) (quote :log)))
          (refs ((core/map::get request) (quote :refs)))
          (runtime ((core/map::get request) (quote :runtime)))
          (store ((core/map::get request) (quote :store)))
          (task ((core/map::get request) (quote :task)))
          (version ((core/map::get request) (quote :v))))
        (if
          (if ((core/eq? kind) "genesis/effect-resource-policy-request-v0.4")
            (if (selfhost/policy::int? version) ((core/int::eq? version) 4) false)
            false)
          (if (selfhost/effect-policy::positive-int? available-workers)
            (if (selfhost/effect-policy::log-resource-policy-valid? log)
              (if (selfhost/effect-policy::refs-resource-policy-valid? refs)
                (if (selfhost/effect-policy::runtime-resource-policy-valid? runtime)
                  (if (selfhost/effect-policy::store-resource-policy-valid? store)
                    (if (selfhost/effect-policy::task-resource-policy-valid? task)
                      (let
                        ((configured-default ((core/map::get task) (quote :default-workers)))
                          (configured-log-store ((core/map::get log) (quote :store-dir)))
                          (configured-refs ((core/map::get refs) (quote :path)))
                          (configured-store ((core/map::get store) (quote :dir)))
                          (normalized-inline
                            (selfhost/effect-policy::normalize-positive-optional
                              ((core/map::get log) (quote :inline-max-bytes)))))
                      {
                        :kind "genesis/effect-resource-policy-result-v0.4"
                        :log
                          {
                            :inline-max-bytes normalized-inline
                            :max-artifact-bytes-per-run
                              (selfhost/effect-policy::normalize-positive-optional
                                ((core/map::get log) (quote :max-artifact-bytes-per-run)))
                            :store-dir
                              (if (selfhost/policy::nil? configured-log-store)
                                (if (selfhost/policy::nil? normalized-inline)
                                  nil
                                  ".genesis/store")
                                configured-log-store)}
                        :refs
                          {
                            :path
                              (if (selfhost/policy::nil? configured-refs)
                                ".genesis/refs.gc"
                                configured-refs)}
                        :request-h (selfhost/hash::hash-term request)
                        :runtime runtime
                        :store
                          {
                            :dir
                              (if (selfhost/policy::nil? configured-store)
                                ".genesis/store"
                                configured-store)
                            :max-run-bytes
                              (selfhost/effect-policy::normalize-positive-optional
                                ((core/map::get store) (quote :max-run-bytes)))
                            :remote-policy
                              (selfhost/effect-store-remote::policy
                                ((core/map::get store) (quote :remote-policy)))}
                        :task
                          {
                            :default-workers
                              (if (selfhost/policy::nil? configured-default)
                                available-workers
                                configured-default)
                            :max-queue ((core/map::get task) (quote :max-queue))
                            :max-steps-per-task
                              ((core/map::get task) (quote :max-steps-per-task))
                            :max-tasks ((core/map::get task) (quote :max-tasks))
                            :max-time-ms-per-task
                              ((core/map::get task) (quote :max-time-ms-per-task))
                            :max-workers ((core/map::get task) (quote :max-workers))}
                        :v 4})
                      ((core/error::make2 "core/policy/authority")
                        "effect task resource policy must contain exact nonnegative limits"))
                    ((core/error::make2 "core/policy/authority")
                      "effect store resource policy must contain exact typed fields"))
                  ((core/error::make2 "core/policy/authority")
                    "effect runtime resource policy must contain exact nonnegative limits"))
                ((core/error::make2 "core/policy/authority")
                  "effect refs resource policy must contain an exact optional path"))
              ((core/error::make2 "core/policy/authority")
                "effect log resource policy must contain exact typed fields"))
            ((core/error::make2 "core/policy/authority")
              "effect resource policy available-workers must be a positive integer"))
          ((core/error::make2 "core/policy/authority")
            "effect resource policy request identity mismatch")))
      ((core/error::make2 "core/policy/authority")
        "effect resource policy request field set mismatch"))))
