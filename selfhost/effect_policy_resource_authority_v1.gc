        false))))

(def selfhost/effect-policy::optional-nonnegative-int?
  (fn (value)
    (if (selfhost/policy::nil? value)
      true
      (if (selfhost/policy::int? value)
        (if ((core/int::lt? value) 0) false true)
        false))))

(def selfhost/effect-policy::positive-int?
  (fn (value)
    (if (selfhost/policy::int? value) ((core/int::lt? 0) value) false)))

(def selfhost/effect-policy::normalize-positive-optional
  (fn (value)
