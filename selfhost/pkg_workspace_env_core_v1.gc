          out
          (((selfhost/pkg-workspace-env::locked-loop locked) ((core/int::add index) 1))
            ((core/vec::push out)
              (selfhost/pkg-workspace-env::locked-term ((core/vec::get locked) index)))))))))

(def selfhost/pkg-workspace-env::locked-present-loop?
  (fn (locked)
    (fn (index)
      (if ((core/int::eq? index) (core/vec::len locked))
        true
        (let ((entry ((core/vec::get locked) index)))
          (if ((core/map::get entry) (quote :snapshot-present))
            (if ((core/map::get entry) (quote :commit-present))
              ((selfhost/pkg-workspace-env::locked-present-loop? locked) ((core/int::add index) 1))
              false)
            false))))))

(def selfhost/pkg-workspace-env::selection-request
  (fn (request)
    {
      :active ((core/map::get request) (quote :active))
      :default ((core/map::get request) (quote :default-backend))
      :kind selfhost/pkg-workspace-env-select::request-kind
      :override ((core/map::get request) (quote :override))
      :profile ((core/map::get request) (quote :profile))
      :profile-backend ((core/map::get request) (quote :profile-backend))
      :v 1}))

(def selfhost/pkg-workspace-env::make-plan
  (fn (request)
    (let ((selection (core/pkg::workspace-env-select-authority
                       (selfhost/pkg-workspace-env::selection-request request))))
      (if ((core/map::get selection) (quote :ok))
        (let ((selected ((core/map::get selection) (quote :value))))
          (if ((core/map::get selected) (quote :compatible))
            (let
              ((profile-values ((core/map::get request) (quote :profile-values)))
                (defaults ((core/map::get request) (quote :defaults)))
                (lock ((core/map::get request) (quote :lock))))
              (if
                ((selfhost/pkg-workspace-env::locked-present-loop?
                    ((core/map::get lock) (quote :locked))) 0)
                (let
                  ((members-term
                    (((selfhost/pkg-workspace-env::members-loop
                        ((core/map::get request) (quote :members))) 0) []))
                    (requirements
                      (((selfhost/pkg-workspace-env::requirements-loop
                          ((core/map::get lock) (quote :requirements))) 0) []))
                    (locked
                      (((selfhost/pkg-workspace-env::locked-loop
                          ((core/map::get lock) (quote :locked))) 0) [])))
                  (let
                    ((deps-term
                      {
                        :locked locked
                        :requirements requirements
                        :store
                          ((core/map::get ((core/map::get request) (quote :paths)))
                            (quote :store-root))})
                      (profile-policy
                        ((core/map::get profile-values) (quote :policy)))
                      (profile-registry
                        ((core/map::get profile-values) (quote :registry)))
                      (profile-toolchain
                        ((core/map::get profile-values) (quote :toolchain))))
                    (let
                      ((members-body (selfhost/pkg-workspace-env::term-bytes members-term))
                        (deps-body (selfhost/pkg-workspace-env::term-bytes deps-term))
                        (effective-policy
                          ((selfhost/pkg-workspace-env::choose profile-policy)
                            ((core/map::get defaults) (quote :policy))))
                        (effective-registry
                          ((selfhost/pkg-workspace-env::choose profile-registry)
                            ((core/map::get defaults) (quote :registry))))
                        (effective-toolchain
                          ((selfhost/pkg-workspace-env::choose profile-toolchain)
                            ((core/map::get defaults) (quote :toolchain))))
                        (caps-policy
                          ((selfhost/pkg-workspace-env::choose
                              ((core/map::get profile-values) (quote :caps-policy)))
                            "caps.toml")))
                      {
                        :code nil
                        :message nil
                        :ok true
                        :value {
                        :active ((core/map::get selected) (quote :active))
                        :backend-required
                          (if
                            ((core/eq?
                                (selfhost/effect-crypto::ascii-lower
                                  ((core/map::get request) (quote :profile)))) "backend")
                            true
                            ((core/eq? ((core/map::get selected) (quote :selected))) "backend"))
                        :caps-policy-raw caps-policy
                        :deps-body deps-body
                        :deps-h (selfhost/pkg-workspace-env::digest deps-body)
                        :effective-policy effective-policy
                        :effective-registry effective-registry
                        :effective-toolchain effective-toolchain
                        :lock-h
                          (selfhost/pkg-workspace-env::digest
                            ((core/map::get request) (quote :lock-bytes)))
                        :members-body members-body
                        :members-h (selfhost/pkg-workspace-env::digest members-body)
                        :profile ((core/map::get request) (quote :profile))
                        :profile-policy profile-policy
                        :profile-registry profile-registry
                        :profile-toolchain profile-toolchain
                        :selected ((core/map::get selected) (quote :selected))
                        :source ((core/map::get selected) (quote :source))
                        :workspace-h
                          (selfhost/pkg-workspace-env::digest
                            ((core/map::get request) (quote :workspace-bytes)))}})))
                {:code "core/pkg/bad-workspace-env" :message "locked dependency object is missing"
                  :ok false :value nil}))
            {:code "core/pkg/bad-workspace-env-selection"
              :message "workspace runtime backend is incompatible with active runtime backend profile"
              :ok false :value nil}))
        {:code "core/pkg/bad-workspace-env-selection"
          :message ((core/map::get selection) (quote :message)) :ok false :value nil}))))

