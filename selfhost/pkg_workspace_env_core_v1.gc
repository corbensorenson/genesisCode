(def selfhost/pkg-workspace-env::request-valid?
  (fn (request)
    (if
      ((selfhost/pkg-lock-read::exact-map? request)
        [
          :active
          :default-backend
          :defaults
          :generated-by
          :kind
          :lock
          :lock-bytes
          :members
          :out-root-prefix
          :override
          :path-separator
          :paths
          :profile
          :profile-backend
          :profile-values
          :v
          :workspace
          :workspace-bytes])
      (let
        ((defaults ((core/map::get request) (quote :defaults)))
          (profile-values ((core/map::get request) (quote :profile-values)))
          (paths ((core/map::get request) (quote :paths))))
        (if ((selfhost/pkg-lock-read::exact-map? defaults) [:policy :registry :toolchain])
          (if
            ((selfhost/pkg-lock-read::exact-map? profile-values)
              [:caps-policy :policy :registry :toolchain])
            (if
              ((selfhost/pkg-lock-read::exact-map? paths)
                [
                  :lock-file
                  :store-root
                  :wasi-http-dir
                  :wasi-https-dir
                  :wasi-root
                  :wasi-runtime-file
                  :workspace-file])
              (if ((selfhost/pkg-scaffold::bounded-str? ((core/map::get request) (quote :active))) 64)
                (if (selfhost/pkg-workspace-env::optional-str? ((core/map::get request) (quote :default-backend)))
                  (if (selfhost/pkg-workspace-env::optional-str? ((core/map::get request) (quote :override)))
                    (if (selfhost/pkg-workspace-env::optional-str? ((core/map::get request) (quote :profile-backend)))
                      (if ((selfhost/pkg-scaffold::bounded-str? ((core/map::get request) (quote :profile))) 256)
                        (if ((selfhost/pkg-scaffold::bounded-str? ((core/map::get request) (quote :workspace))) 4096)
                          (if ((selfhost/pkg-scaffold::bounded-str? ((core/map::get request) (quote :generated-by))) 4096)
                            (if ((selfhost/pkg-scaffold::bounded-str? ((core/map::get request) (quote :out-root-prefix))) 16384)
                              (if ((selfhost/pkg-scaffold::bounded-str? ((core/map::get request) (quote :path-separator))) 4)
                                (if (selfhost/pkg-workspace-env::byte-body? ((core/map::get request) (quote :workspace-bytes)))
                                  (if (selfhost/pkg-workspace-env::byte-body? ((core/map::get request) (quote :lock-bytes)))
                                    (if (selfhost/pkg-workspace-env::members-valid? ((core/map::get request) (quote :members)))
                                      (if (selfhost/pkg-workspace-env::lock-valid? ((core/map::get request) (quote :lock)))
                                        (if (selfhost/pkg-workspace-env::optional-str? ((core/map::get defaults) (quote :policy)))
                                          (if (selfhost/pkg-workspace-env::optional-str? ((core/map::get defaults) (quote :registry)))
                                            (if (selfhost/pkg-workspace-env::optional-str? ((core/map::get defaults) (quote :toolchain)))
                                              (if (selfhost/pkg-workspace-env::optional-str? ((core/map::get profile-values) (quote :caps-policy)))
                                                (if (selfhost/pkg-workspace-env::optional-str? ((core/map::get profile-values) (quote :policy)))
                                                  (if (selfhost/pkg-workspace-env::optional-str? ((core/map::get profile-values) (quote :registry)))
                                                    (if (selfhost/pkg-workspace-env::optional-str? ((core/map::get profile-values) (quote :toolchain)))
                                                      (if (selfhost/pkg-workspace-env::bounded-path? ((core/map::get paths) (quote :workspace-file)))
                                                        (if (selfhost/pkg-workspace-env::bounded-path? ((core/map::get paths) (quote :lock-file)))
                                                          (if (selfhost/pkg-workspace-env::bounded-path? ((core/map::get paths) (quote :store-root)))
                                                            (if (selfhost/pkg-workspace-env::bounded-path? ((core/map::get paths) (quote :wasi-root)))
                                                              (if (selfhost/pkg-workspace-env::bounded-path? ((core/map::get paths) (quote :wasi-http-dir)))
                                                                (if (selfhost/pkg-workspace-env::bounded-path? ((core/map::get paths) (quote :wasi-https-dir)))
                                                                  (selfhost/pkg-workspace-env::bounded-path? ((core/map::get paths) (quote :wasi-runtime-file)))
                                                                  false)
                                                                false)
                                                              false)
                                                            false)
                                                          false)
                                                        false)
                                                      false)
                                                    false)
                                                  false)
                                                false)
                                              false)
                                            false)
                                          false)
                                        false)
                                      false)
                                    false)
                                  false)
                                false)
                              false)
                            false)
                          false)
                        false)
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false))
      false)))

(def selfhost/pkg-workspace-env::member-term
  (fn (member)
    {
      :name ((core/map::get member) (quote :name))
      :package-file (selfhost/pkg-workspace-env::optional ((core/map::get member) (quote :package-file)))
      :package-h (selfhost/pkg-workspace-env::optional ((core/map::get member) (quote :package-h)))
      :path ((core/map::get member) (quote :path))
      :role (selfhost/pkg-workspace-env::optional ((core/map::get member) (quote :role)))}))

(def selfhost/pkg-workspace-env::members-loop
  (fn (members)
    (fn (index)
      (fn (out)
        (if ((core/int::eq? index) (core/vec::len members))
          out
          (((selfhost/pkg-workspace-env::members-loop members) ((core/int::add index) 1))
            ((core/vec::push out)
              (selfhost/pkg-workspace-env::member-term ((core/vec::get members) index)))))))))

(def selfhost/pkg-workspace-env::requirement-term
