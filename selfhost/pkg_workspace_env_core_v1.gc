; Pure workspace environment projection and materialization-plan construction.

(def selfhost/pkg-workspace-env::none (quote :none))

(def selfhost/pkg-workspace-env::bool?
  (fn (value) ((core/sym::eq? (core/data::tag value)) (quote :bool))))

(def selfhost/pkg-workspace-env::bytes?
  (fn (value) ((core/sym::eq? (core/data::tag value)) (quote :bytes))))

(def selfhost/pkg-workspace-env::optional
  (fn (value) (if (core/list::is-nil? value) selfhost/pkg-workspace-env::none value)))

(def selfhost/pkg-workspace-env::choose
  (fn (primary) (fn (fallback) (if (core/list::is-nil? primary) fallback primary))))

(def selfhost/pkg-workspace-env::digest
  (fn (bytes) (core/bytes::to-hex (core/crypto::blake3 bytes))))

(def selfhost/pkg-workspace-env::term-bytes
  (fn (term)
    (core/str::to-utf8 ((core/str::concat (core/coreform::print-term term)) "\n"))))

(def selfhost/pkg-workspace-env::file
  (fn (scope)
    (fn (path)
      (fn (body)
        {:body body :h (selfhost/pkg-workspace-env::digest body) :path path :scope scope}))))

(def selfhost/pkg-workspace-env::bounded-path?
  (fn (value) ((selfhost/pkg-scaffold::bounded-str? value) 16384)))

(def selfhost/pkg-workspace-env::optional-path?
  (fn (value)
    (if (core/list::is-nil? value)
      true
      (selfhost/pkg-workspace-env::bounded-path? value))))

(def selfhost/pkg-workspace-env::optional-str?
  (fn (value)
    (if (core/list::is-nil? value)
