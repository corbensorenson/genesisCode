(def selfhost/pkg-workspace-env::hex64?
  (fn (value) (selfhost/pkg-lock-ops::lower-hex64? value)))

(def selfhost/pkg-workspace-env::byte-body?
  (fn (value)
    (if (selfhost/pkg-workspace-env::bytes? value)
      (if ((core/int::lt? 16777216) (core/bytes::len value)) false true)
      false)))

(def selfhost/pkg-workspace-env::member-valid?
  (fn (member)
