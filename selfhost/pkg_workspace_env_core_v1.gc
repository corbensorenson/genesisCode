      ((selfhost/pkg-lock-read::exact-map? member)
        [:name :package-file :package-h :path :role])
      (if ((selfhost/pkg-scaffold::bounded-str? ((core/map::get member) (quote :name))) 4096)
        (if ((selfhost/pkg-scaffold::bounded-str? ((core/map::get member) (quote :path))) 16384)
          (if (selfhost/pkg-workspace-env::optional-str? ((core/map::get member) (quote :role)))
            (let
              ((package-file ((core/map::get member) (quote :package-file)))
                (package-h ((core/map::get member) (quote :package-h))))
              (if (core/list::is-nil? package-file)
                (core/list::is-nil? package-h)
                (if (selfhost/pkg-workspace-env::bounded-path? package-file)
                  (selfhost/pkg-workspace-env::hex64? package-h)
                  false)))
            false)
          false)
        false)
      false)))

(def selfhost/pkg-workspace-env::members-valid-loop?
  (fn (members)
