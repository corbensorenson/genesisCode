      :tag-policy (selfhost/pkg-workspace-env::optional ((core/map::get requirement) (quote :tag-policy)))
      :update-policy ((core/map::get requirement) (quote :update-policy))}))

(def selfhost/pkg-workspace-env::requirements-loop
  (fn (requirements)
