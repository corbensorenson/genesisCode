; Closed semantic authority for gcpm remove lock mutation and reporting.

(def selfhost/pkg-workspace-remove::request-kind
  "genesis/pkg-workspace-remove-authority-request-v0.1")
(def selfhost/pkg-workspace-remove::result-kind
  "genesis/pkg-workspace-remove-authority-result-v0.1")

(def selfhost/pkg-workspace-remove::bytes-equal-loop
  (fn (left)
    (fn (right)
      (fn (index)
        (fn (length)
          (if ((core/int::eq? index) length)
            true
            (if
              ((core/int::eq? ((core/bytes::get left) index))
                ((core/bytes::get right) index))
              ((((selfhost/pkg-workspace-remove::bytes-equal-loop left) right)
                  ((core/int::add index) 1))
                length)
              false)))))))

(def selfhost/pkg-workspace-remove::string-equal?
  (fn (left)
    (fn (right)
      (let
        ((left-bytes (core/str::to-utf8 left))
          (right-bytes (core/str::to-utf8 right)))
        (let ((length (core/bytes::len left-bytes)))
          (if ((core/int::eq? length) (core/bytes::len right-bytes))
            ((((selfhost/pkg-workspace-remove::bytes-equal-loop left-bytes) right-bytes) 0)
              length)
            false))))))

(def selfhost/pkg-workspace-remove::remove-loop
  (fn (entries)
    (fn (index)
      (fn (name)
        (fn (out)
          (fn (removed)
            (if ((core/int::eq? index) (core/vec::len entries))
              {:map out :removed removed}
              (let ((entry ((core/vec::get entries) index)))
                (let
                  ((key ((core/vec::get entry) 0))
                    (value ((core/vec::get entry) 1)))
                  (let ((matches ((selfhost/pkg-workspace-remove::string-equal? key) name)))
                    (((((selfhost/pkg-workspace-remove::remove-loop entries)
                        ((core/int::add index) 1))
                      name)
                      (if matches out (((core/map::put out) key) value)))
                      (if matches true removed))))))))))))

(def selfhost/pkg-workspace-remove::remove-name
  (fn (value)
    (fn (name)
      (if (selfhost/pkg-lock-read::map? value)
        (((((selfhost/pkg-workspace-remove::remove-loop (core/map::entries value)) 0) name) {}) false)
        nil))))

(def selfhost/pkg-workspace-remove::result
  (fn (request-h)
    (fn (ok)
      (fn (code)
        (fn (message)
          (fn (value)
            {
              :code code
              :kind "genesis/pkg-workspace-remove-authority-result-v0.1"
              :message message
              :ok ok
              :request-h request-h
              :v 1
              :value value}))))))

(def selfhost/pkg-workspace-remove::reject
  (fn (request-h)
    (fn (message)
      (((((selfhost/pkg-workspace-remove::result request-h) false)
          "core/pkg/bad-workspace-remove")
        message)
      nil))))

(def selfhost/pkg-workspace-remove::accept
  (fn (request-h)
    (fn (value)
      (((((selfhost/pkg-workspace-remove::result request-h) true) nil) nil) value))))

(def selfhost/pkg-workspace-remove::finish
  (fn (request-h)
    (fn (lock)
      (fn (name)
        (fn (model)
          (fn (requirements)
            (fn (locked)
              ((selfhost/pkg-workspace-remove::accept request-h)
                {
                  :lock lock
                  :model {
                    :artifacts ((core/map::get model) (quote :artifacts))
                    :locked ((core/map::get locked) (quote :map))
                    :policy ((core/map::get model) (quote :policy))
                    :registries ((core/map::get model) (quote :registries))
                    :requirements ((core/map::get requirements) (quote :map))
                    :version ((core/map::get model) (quote :version))
                    :workspace ((core/map::get model) (quote :workspace))}
                  :name name
                  :removed
                    (if ((core/map::get requirements) (quote :removed))
                      true
                      ((core/map::get locked) (quote :removed)))}))))))))

(def selfhost/pkg-workspace-remove::authorize-model
  (fn (request-h)
    (fn (lock)
      (fn (name)
        (fn (model)
          (if
            ((selfhost/pkg-lock-read::exact-map? model)
              [:artifacts :locked :policy :registries :requirements :version :workspace])
            (let
              ((requirements
                ((selfhost/pkg-workspace-remove::remove-name
                    ((core/map::get model) (quote :requirements)))
                  name))
                (locked
                  ((selfhost/pkg-workspace-remove::remove-name
                      ((core/map::get model) (quote :locked)))
                    name)))
              ((((((selfhost/pkg-workspace-remove::finish request-h) lock) name) model)
                  requirements)
                locked))
            ((selfhost/pkg-workspace-remove::reject request-h)
              "model fields mismatch")))))))

(def core/pkg::workspace-remove-authority
  (fn (request)
    (let ((request-h (selfhost/hash::hash-term request)))
      (if (selfhost/pkg-lock-read::map? request)
        (if
          ((selfhost/pkg-lock-read::exact-map? request) [:kind :lock :model :name :v])
          (let
            ((kind ((core/map::get request) (quote :kind)))
              (lock ((core/map::get request) (quote :lock)))
              (model ((core/map::get request) (quote :model)))
              (name ((core/map::get request) (quote :name)))
              (version ((core/map::get request) (quote :v))))
            (if
              (if (selfhost/pkg-lock-read::str? kind)
                ((core/eq? kind) selfhost/pkg-workspace-remove::request-kind)
                false)
              (if
                (if (selfhost/pkg-lock-read::str? lock)
                  (if (selfhost/pkg-lock-read::str? name)
                    ((core/int::lt? 0) (core/str::len name))
                    false)
                  false)
                (if
                  (if (selfhost/pkg-lock-read::int? version)
                    ((core/int::eq? version) 1)
                    false)
                  ((((selfhost/pkg-workspace-remove::authorize-model request-h) lock) name) model)
                  ((selfhost/pkg-workspace-remove::reject request-h)
                    "request :v must be 1"))
                ((selfhost/pkg-workspace-remove::reject request-h)
                  "request :lock and non-empty :name must be strings"))
              ((selfhost/pkg-workspace-remove::reject request-h)
                "request :kind mismatch")))
          ((selfhost/pkg-workspace-remove::reject request-h)
            "request fields mismatch"))
        ((selfhost/pkg-workspace-remove::reject request-h)
          "request must be map")))))
