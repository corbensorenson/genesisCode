                       (((((selfhost/obligation::budget-error suite) name)
                            "max_effect_log_bytes_per_test") log-bytes) max-log-bytes))
                     errors1)))
                {:errors errors2
                 :ok (if step-bad false (if entry-bad false (if log-bad false true)))
                 :report
                   {:effect-entries entries
                    :effect-log-bytes log-bytes
                    :name name
                    :ok (if step-bad false (if entry-bad false (if log-bad false true)))
                    :steps steps
                    :suite suite}}))))))))

