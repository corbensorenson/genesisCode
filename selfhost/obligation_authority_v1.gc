(def selfhost/obligation::budget-test
  (fn (test)
    (fn (limits)
      (let
        ((suite ((core/map::get test) (quote :suite)))
          (name ((core/map::get test) (quote :name)))
          (steps ((core/map::get test) (quote :steps)))
          (entries ((core/map::get test) (quote :effect-entries)))
          (log-bytes ((core/map::get test) (quote :effect-log-bytes)))
          (max-steps ((core/map::get limits) (quote :max-steps-per-test)))
          (max-entries ((core/map::get limits) (quote :max-effect-entries-per-test)))
          (max-log-bytes ((core/map::get limits) (quote :max-effect-log-bytes-per-test))))
        (let
          ((step-bad ((selfhost/obligation::limit-exceeded? steps) max-steps))
            (entry-bad ((selfhost/obligation::limit-exceeded? entries) max-entries))
            (log-bad ((selfhost/obligation::limit-exceeded? log-bytes) max-log-bytes)))
          (let
            ((errors0
               (if step-bad
                 ((core/vec::push [])
                   (((((selfhost/obligation::budget-error suite) name)
                        "max_steps_per_test") steps) max-steps))
                 [])))
            (let
              ((errors1
