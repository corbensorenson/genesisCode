      (selfhost/obligation::error ":typecheck inputs must contain exactly :modules"))))

(def selfhost/obligation::bind-result
  (fn (request)
    (fn (result)
      (if (core/error::is? result)
        result
        (((core/map::put result) (quote :request-h))
          (selfhost/hash::hash-term request))))))

(def selfhost/obligation::dispatch
  (fn (operation)
    (fn (package)
      (fn (inputs)
        (if ((core/sym::eq? operation) (quote :unit-tests))
          (if ((core/int::eq? (core/map::len inputs)) 1)
            (let ((tests ((core/map::get inputs) (quote :tests))))
              (if (selfhost/obligation::vec? tests)
                (((selfhost/obligation::unit-tests package) {}) tests)
                (selfhost/obligation::error ":unit-tests :tests input must be a vector")))
            (selfhost/obligation::error ":unit-tests inputs must contain exactly :tests"))
          (if ((core/sym::eq? operation) (quote :budgets))
            (if ((core/int::eq? (core/map::len inputs)) 2)
              (let ((tests ((core/map::get inputs) (quote :tests))))
                (if (selfhost/obligation::vec? tests)
                  (((selfhost/obligation::budgets package)
                     ((core/map::get inputs) (quote :limits))) tests)
                  (selfhost/obligation::error ":budgets :tests input must be a vector")))
              (selfhost/obligation::error ":budgets inputs must contain exactly :limits and :tests"))
            (if ((core/sym::eq? operation) (quote :capabilities-declared))
              ((selfhost/obligation::capabilities-declared package) inputs)
              (if ((core/sym::eq? operation) (quote :typecheck))
                (selfhost/obligation::typecheck inputs)
                (selfhost/obligation::error "unknown obligation authority operation")))))))))

(def core/cli::obligation-authority
  (fn (request)
    (if (selfhost/obligation::map? request)
      (if ((core/int::eq? (core/map::len request)) 5)
        (let
          ((kind ((core/map::get request) (quote :kind)))
            (version ((core/map::get request) (quote :v)))
            (operation ((core/map::get request) (quote :operation)))
            (package ((core/map::get request) (quote :package)))
            (inputs ((core/map::get request) (quote :inputs))))
          (if (if (selfhost/obligation::str? kind)
                ((core/eq? kind) selfhost/obligation::REQUEST_KIND)
                false)
            (if (if (selfhost/obligation::int? version)
                  ((core/int::eq? version) 2)
                  false)
              (if (selfhost/obligation::str? package)
                (if (selfhost/obligation::map? inputs)
                  (let ((result (((selfhost/obligation::dispatch operation) package) inputs)))
                    ((selfhost/obligation::bind-result request) result))
                  (selfhost/obligation::error "request :inputs must be a map"))
                (selfhost/obligation::error "request :package must be a string"))
              (selfhost/obligation::error "request :v must equal 2"))
            (selfhost/obligation::error "request :kind mismatch")))
        (selfhost/obligation::error "request must contain exactly five fields"))
      (selfhost/obligation::error "request must be a map"))))
