        (if ((core/sym::eq? phase) (quote :put))
          (selfhost/store-authority::put-request request)
          (if ((core/sym::eq? phase) (quote :has))
            (selfhost/store-authority::has request)
            (if ((core/sym::eq? phase) (quote :get))
              (selfhost/store-authority::get request)
              ((selfhost/store-authority::protocol-reject request)
                "unsupported store phase")))))
      ((selfhost/store-authority::protocol-reject request) "store request must be a map"))))
