                        (if (selfhost/store-verify::vec? derived)
                          (if ((selfhost/store-verify::hash-vectors-equal? derived) hashes)
                            (((selfhost/store-verify::check-observations request) hashes)
                              (if (selfhost/store-authority::nil? hash) false true))
                            ((selfhost/store-verify::reject request)
                              "verify selected hash inventory mismatch"))
                          ((selfhost/store-verify::reject request)
                            "verify inventory cannot be derived")))
