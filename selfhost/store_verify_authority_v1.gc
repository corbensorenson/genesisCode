                "store verify payload must contain exactly :hash") nil) 0)))))

(def core/store::verify-authority
  (fn (request)
    (if
      ((selfhost/store-authority::exact-map? request)
        [:entries :hashes :kind :max-bytes :max-entries :max-total-bytes :observations :payload
          :phase :status :v])
      (if
        ((core/eq? ((selfhost/store-authority::field request) (quote :kind)))
          "genesis/store-verify-authority-request-v0.1")
        (if ((core/int::eq? ((selfhost/store-authority::field request) (quote :v))) 1)
          (if
            ((core/sym::eq? ((selfhost/store-authority::field request) (quote :phase)))
              (quote :verify))
            (selfhost/store-verify::decide request)
            ((selfhost/store-verify::reject request) "verify phase mismatch"))
          ((selfhost/store-verify::reject request) "verify request version mismatch"))
        ((selfhost/store-verify::reject request) "verify request kind mismatch"))
      ((selfhost/store-verify::reject request) "verify request fields mismatch"))))
