        (max-bytes ((selfhost/store-authority::field request) (quote :max-bytes)))
        (max-total ((selfhost/store-authority::field request) (quote :max-total-bytes))))
      (if ((selfhost/store-authority::exact-map? payload) [:hash])
        (if (selfhost/store-authority::nonnegative-int? max-entries)
          (if (selfhost/store-authority::nonnegative-int? max-bytes)
            (if (selfhost/store-authority::nonnegative-int? max-total)
              (let ((hash ((selfhost/store-authority::field payload) (quote :hash))))
                (if ((core/sym::eq? status) (quote :plan))
