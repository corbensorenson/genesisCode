                                          (let ((out11 ((selfhost/pkg-scaffold::append out10) "runtime_backend = \"backend\"\n\n[profiles.\"ci\"]\ncaps_policy = \"caps.ci.toml\"\n")))
                                            (let ((out12 ((selfhost/pkg-scaffold::append out11) registry-line)))
