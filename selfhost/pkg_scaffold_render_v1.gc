        (let ((out1 ((selfhost/pkg-scaffold::append out0) "::main]\n      :types {")))
          (let ((out2 ((selfhost/pkg-scaffold::append out1) namespace)))
            (let ((out3 ((selfhost/pkg-scaffold::append out2) "::main ?}}))\n\n(def ")))
              (let ((out4 ((selfhost/pkg-scaffold::append out3) namespace)))
