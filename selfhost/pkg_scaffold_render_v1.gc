(def selfhost/pkg-scaffold::readme-body
  (fn (workspace)
    (fn (package)
      (fn (archetype)
        (fn (backend)
          (fn (primary)
            (let ((out0 ((selfhost/pkg-scaffold::append "# ") workspace)))
              (let ((out1 ((selfhost/pkg-scaffold::append out0) "\n\nDeterministic `gcpm scaffold` workspace for archetype `")))
