                  (let ((out6 ((selfhost/pkg-scaffold::append out5) archetype)))
                    (let ((out7 ((selfhost/pkg-scaffold::append out6) "\n      :status \"scaffold-ok\"}))\n\n")))
                      (let ((out8 ((selfhost/pkg-scaffold::append out7) namespace)))
