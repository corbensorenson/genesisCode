                                                (let ((out14 ((selfhost/pkg-scaffold::append out13) "runtime_backend = \"headless\"\n\n[profiles.\"dev\"]\ncaps_policy = \"caps.toml\"\n")))
                                                  (let ((out15 ((selfhost/pkg-scaffold::append out14) registry-line)))
                                                    (let ((out16 ((selfhost/pkg-scaffold::append out15) policy-line)))
                                                      (let ((out17 ((selfhost/pkg-scaffold::append out16) "runtime_backend = \"")))
