                    (let ((out4 ((selfhost/pkg-scaffold::append out3) primary)))
                      (let ((out5 ((selfhost/pkg-scaffold::append out4) "`\n\n## Scaffold Contract\n\n- package: `")))
                        (let ((out6 ((selfhost/pkg-scaffold::append out5) package)))
