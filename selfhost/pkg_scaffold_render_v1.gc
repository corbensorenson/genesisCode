                                                          (let ((out19 ((selfhost/pkg-scaffold::append out18) "\"\n\n[profiles.\"release\"]\ncaps_policy = \"caps.release.toml\"\n")))
                                                            (let ((out20 ((selfhost/pkg-scaffold::append out19) registry-line)))
