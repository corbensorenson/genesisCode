                                  (let ((out7 ((selfhost/pkg-scaffold::append out6) backend)))
                                    (let ((out8 ((selfhost/pkg-scaffold::append out7) "\"\n\n[profiles.\"backend\"]\ncaps_policy = \"caps.backend.toml\"\n")))
                                      (let ((out9 ((selfhost/pkg-scaffold::append out8) registry-line)))
