(def selfhost/pkg-scaffold::lock-body
  (fn (workspace)
    (fn (policy)
      (fn (registry)
        (let
          ((escaped-policy (selfhost/pkg-scaffold::toml-string policy))
            (escaped-registry
              (if (core/list::is-nil? registry)
                nil
                (selfhost/pkg-scaffold::toml-string registry))))
          (let ((out0 ((selfhost/pkg-scaffold::append "version = 2\nworkspace = \"") workspace)))
            (let ((out1 ((selfhost/pkg-scaffold::append out0) "\"\npolicy = \"")))
              (let ((out2 ((selfhost/pkg-scaffold::append out1) escaped-policy)))
                (let ((out3 ((selfhost/pkg-scaffold::append out2) "\"\n")))
                  (let
                    ((out4
                      (if (core/list::is-nil? escaped-registry)
                        out3
                        ((selfhost/pkg-scaffold::append
                            ((selfhost/pkg-scaffold::append out3)
                              "\n[registries]\ndefault = \""))
                          ((selfhost/pkg-scaffold::append escaped-registry) "\"\n")))))
                    ((selfhost/pkg-scaffold::append out4) "\n[requirements]\n\n[locked]\n\n")))))))))))

(def selfhost/pkg-scaffold::package-body
  (fn (package)
    ((selfhost/pkg-scaffold::append
        ((selfhost/pkg-scaffold::append "schema = 1\nname = \"") package))
      "\"\nversion = \"0.1.0\"\nobligations = []\ndependencies = []\ntests = []\nproperty_tests = []\ncaps_policy = \"caps.toml\"\n\n[[modules]]\npath = \"src/main.gc\"\n")))

