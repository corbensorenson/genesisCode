                    ((selfhost/pkg-lock-write::section "[artifacts]\n")
                      ((selfhost/pkg-lock-write::render-map ((core/map::get payload) (quote :artifacts)))
                        selfhost/pkg-lock-write::render-bare-string-entry))))
                ((((selfhost/pkg-lock-write::assemble-lock payload) workspace) policy)
                  {
                    :artifacts artifacts
                    :locked locked
                    :registries registries
                    :requirements requirements})))))))))

(def selfhost/pkg-lock-write::render-lock
  (fn (payload)
    (if (selfhost/pkg-lock-write::map? payload)
      (let ((workspace ((core/map::get payload) (quote :workspace))))
        (if (selfhost/pkg-lock-write::str? workspace)
          (let ((policy0 ((core/map::get payload) (quote :policy))))
            (if
              (if (selfhost/pkg-lock-write::nil? policy0)
                true
                (selfhost/pkg-lock-write::str? policy0))
              (let
                ((policy (if (selfhost/pkg-lock-write::nil? policy0) "policy:default-v0.1" policy0)))
                (((selfhost/pkg-lock-write::render-lock-sections payload) workspace) policy))
              {:error ":policy must be string or nil" :text ""}))
          {:error ":workspace must be string" :text ""}))
      {:error "payload must be map" :text ""})))

(def selfhost/pkg-lock-write::result
  (fn (request-h)
    (fn (ok)
      (fn (code)
        (fn (message)
          (fn (bytes)
            (fn (lock-h)
              {
                :bytes bytes
                :code code
                :kind "genesis/pkg-lock-write-authority-result-v0.1"
                :lock-h lock-h
                :message message
                :ok ok
                :request-h request-h
                :v 1})))))))

(def selfhost/pkg-lock-write::reject
  (fn (request-h)
    (fn (code)
      (fn (message)
        ((((((selfhost/pkg-lock-write::result request-h) false) code) message) nil) nil)))))

(def selfhost/pkg-lock-write::accept
  (fn (request-h)
    (fn (bytes)
      ((((((selfhost/pkg-lock-write::result request-h) true) nil) nil) bytes)
        (core/bytes::to-hex (core/crypto::blake3 bytes))))))

(def core/pkg::lock-write-authority
  (fn (request)
    (let ((request-h (selfhost/hash::hash-term request)))
      (if (selfhost/pkg-lock-write::map? request)
        (let ((fields (core/map::entries request)))
          (if ((core/int::eq? (core/vec::len fields)) 4)
            (let ((kind ((core/map::get request) (quote :kind))))
              (if
                (if (selfhost/pkg-lock-write::str? kind)
                  ((core/eq? kind) "genesis/pkg-lock-write-authority-request-v0.1")
                  false)
                (let ((op ((core/map::get request) (quote :op))))
                  (if
                    (if (selfhost/pkg-lock-write::sym? op)
                      ((core/sym::eq? op) (quote :write))
                      false)
                    (let ((version ((core/map::get request) (quote :v))))
                      (if
                        (if (selfhost/pkg-lock-write::int? version)
                          ((core/int::eq? version) 1)
                          false)
                        (let
                          ((rendered (selfhost/pkg-lock-write::render-lock ((core/map::get request) (quote :payload)))))
                          (let ((error ((core/map::get rendered) (quote :error))))
                            (if (selfhost/pkg-lock-write::nil? error)
                              (let
                                ((bytes (core/str::to-utf8 ((core/map::get rendered) (quote :text)))))
                                ((selfhost/pkg-lock-write::accept request-h) bytes))
                              (((selfhost/pkg-lock-write::reject request-h) "core/pkg/bad-payload")
                                error))))
                        (((selfhost/pkg-lock-write::reject request-h) "core/pkg/bad-authority-request")
                          "request :v must be 1")))
                    (((selfhost/pkg-lock-write::reject request-h) "core/pkg/bad-authority-request")
                      "request :op must be :write")))
                (((selfhost/pkg-lock-write::reject request-h) "core/pkg/bad-authority-request")
                  "request :kind mismatch")))
            (((selfhost/pkg-lock-write::reject request-h) "core/pkg/bad-authority-request")
              "request fields mismatch")))
        (((selfhost/pkg-lock-write::reject request-h) "core/pkg/bad-authority-request")
          "request must be map")))))
