                (((selfhost/typecheck::profile-error-all modules)
                   ((core/map::get collected) (quote :errors)))
                  "genesis/profile-negotiation-v0.1 requires successful module resolution"))))
          (let
            ((errors1
               (if ((core/map::get collected) (quote :mismatch))
                 (((selfhost/typecheck::profile-error-all modules) errors0)
                   "package modules declare different :package-profile-requirements")
                 errors0))
              (selection
                (if (selfhost/typecheck::map? requirements)
                  (if
                    ((core/int::eq? (core/map::len requirements))
                      (core/vec::len selfhost/typecheck::profile-families))
                    (selfhost/typecheck::select-package-profiles requirements)
                    {:errors [] :selected {}})
                  {:errors [] :selected {}})))
            (let
