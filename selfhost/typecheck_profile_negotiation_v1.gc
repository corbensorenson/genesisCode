(def selfhost/typecheck::collect-profile-requirements-loop
  (fn (modules)
    (fn (n)
      (fn (i)
        (if ((core/int::eq? i) n)
          {:errors {} :mismatch false :requirements nil}
          (let
            ((parsed
               (selfhost/typecheck::parse-module-profile-negotiation
                 ((core/vec::get modules) i)))
              (rest
                (((selfhost/typecheck::collect-profile-requirements-loop modules) n)
                  ((core/int::add i) 1))))
            (let
              ((incoming ((core/map::get parsed) (quote :requirements)))
                (existing ((core/map::get rest) (quote :requirements))))
              {:errors
                 (((selfhost/typecheck::profile-errors-add-vector
                      ((core/map::get rest) (quote :errors)))
                    ((core/map::get parsed) (quote :path)))
                   ((core/map::get parsed) (quote :errors)))
               :mismatch
                 (if ((core/map::get rest) (quote :mismatch))
                   true
                   (if (selfhost/typecheck::nil? incoming)
                     false
                     (if (selfhost/typecheck::nil? existing)
                       false
                       (if ((core/eq? incoming) existing) false true))))
               :requirements
                 (if (selfhost/typecheck::nil? existing) incoming existing)})))))))

