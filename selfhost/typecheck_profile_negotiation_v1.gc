(def selfhost/typecheck::parse-profile-requirement
  (fn (family)
    (fn (value)
      (if (selfhost/typecheck::map? value)
        (if
          (if ((core/int::eq? (core/map::len value)) 2)
            (if ((selfhost/typecheck::map-has-key? value) (quote :mode))
              ((selfhost/typecheck::map-has-key? value) (quote :profile))
              false)
            false)
          (let
            ((mode ((core/map::get value) (quote :mode)))
              (profile ((core/map::get value) (quote :profile))))
            (if (selfhost/typecheck::sym? mode)
              (if
                (if ((core/sym::eq? mode) (quote exact))
                  true
                  ((core/sym::eq? mode) (quote minimum)))
                (if (selfhost/typecheck::sym? profile)
                  (if ((selfhost/typecheck::profile-registered? family) profile)
                    (selfhost/typecheck::ok {:mode mode :profile profile})
                    (selfhost/typecheck::err
                      ((selfhost/typecheck::str4 "profile "
                         (selfhost/typecheck::symbol-str profile))
                        " is not registered in family "
                        (selfhost/typecheck::symbol-str family))))
                  (selfhost/typecheck::err
                    ((selfhost/typecheck::str2 "required profile for ")
                      ((selfhost/typecheck::str2
                         (selfhost/typecheck::symbol-str family))
                        " must be a symbol"))))
                (selfhost/typecheck::err
                  ((selfhost/typecheck::str4 "unsupported requirement mode "
                     (selfhost/typecheck::symbol-str mode))
                    " for "
                    (selfhost/typecheck::symbol-str family))))
              (selfhost/typecheck::err
                ((selfhost/typecheck::str2 "requirement mode for ")
                  ((selfhost/typecheck::str2 (selfhost/typecheck::symbol-str family))
                    " must be exact or minimum")))))
          (selfhost/typecheck::err
            ((selfhost/typecheck::str2 "requirement for ")
              ((selfhost/typecheck::str2 (selfhost/typecheck::symbol-str family))
                " must contain only :mode and :profile"))))
        (selfhost/typecheck::err
          ((selfhost/typecheck::str2 "requirement for ")
            ((selfhost/typecheck::str2 (selfhost/typecheck::symbol-str family))
              " must be a map")))))))

(def selfhost/typecheck::parse-profile-requirements
  (fn (value)
    (if (selfhost/typecheck::map? value)
      (let ((entries (core/map::entries value)))
        (((selfhost/typecheck::parse-profile-requirements-loop entries) 0)
          {:errors [] :requirements {}}))
      {:errors [":package-profile-requirements must be a map"]
        :requirements nil})))

(def selfhost/typecheck::parse-profile-requirements-loop
  (fn (entries)
    (fn (i)
      (fn (state)
        (if ((core/int::eq? i) (core/vec::len entries))
          (if
            ((core/int::eq?
               (core/map::len ((core/map::get state) (quote :requirements))))
              (core/vec::len selfhost/typecheck::profile-families))
            state
            (((core/map::put state) (quote :errors))
              ((core/vec::push ((core/map::get state) (quote :errors)))
                ":package-profile-requirements must exactly declare [genesis/profile-family/artifact, genesis/profile-family/capability, genesis/profile-family/language, genesis/profile-family/target]")))
          (let
            ((entry ((core/vec::get entries) i))
              (rest-i ((core/int::add i) 1)))
            (let
              ((family ((core/vec::get entry) 0))
                (value ((core/vec::get entry) 1)))
              (if (selfhost/typecheck::sym? family)
                (let
                  ((lineage
                     ((core/map::get selfhost/typecheck::profile-lineages) family)))
                  (if (selfhost/typecheck::vec? lineage)
                    (let
                      ((parsed
                         ((selfhost/typecheck::parse-profile-requirement family) value)))
                      (((selfhost/typecheck::parse-profile-requirements-loop entries) rest-i)
                        (if (selfhost/typecheck::result-ok? parsed)
                          (((core/map::put state) (quote :requirements))
                            (((core/map::put
                                 ((core/map::get state) (quote :requirements)))
                                family)
                              ((core/map::get parsed) (quote :value))))
                          (((core/map::put state) (quote :errors))
                            ((core/vec::push
                               ((core/map::get state) (quote :errors)))
                              ((core/map::get parsed) (quote :error)))))))
                    (((selfhost/typecheck::parse-profile-requirements-loop entries) rest-i)
                      (((core/map::put state) (quote :errors))
                        ((core/vec::push ((core/map::get state) (quote :errors)))
                          ((selfhost/typecheck::str2 "unknown profile family ")
                            (selfhost/typecheck::symbol-str family)))))))
                (((selfhost/typecheck::parse-profile-requirements-loop entries) rest-i)
                  (((core/map::put state) (quote :errors))
                    ((core/vec::push ((core/map::get state) (quote :errors)))
                      "profile requirement family keys must be symbols")))))))))))

(def selfhost/typecheck::parse-module-profile-negotiation
  (fn (module)
    (let
      ((meta ((core/map::get module) (quote :meta)))
        (path ((core/map::get module) (quote :path))))
      (if (selfhost/typecheck::map? meta)
        (let
          ((profile ((core/map::get meta) (quote :profile-negotiation)))
            (profile-errors
              (if
                ((selfhost/typecheck::map-has-key? meta) (quote :profile-negotiation))
                (if
                  (if (selfhost/typecheck::sym? profile)
                    ((core/sym::eq? profile) selfhost/typecheck::profile-negotiation-id)
                    false)
                  []
                  ((core/vec::push [])
                    ((selfhost/typecheck::str4
                       ":profile-negotiation must be exact symbol genesis/profile-negotiation-v0.1, got ")
                      (selfhost/typecheck::term-str profile)
                      ""
                      "")))
                ["every module in the package closure must declare :profile-negotiation genesis/profile-negotiation-v0.1"]))
            (parsed
              (if
                ((selfhost/typecheck::map-has-key? meta)
                  (quote :package-profile-requirements))
                (selfhost/typecheck::parse-profile-requirements
                  ((core/map::get meta) (quote :package-profile-requirements)))
                {:errors ["profile negotiation requires :package-profile-requirements"]
                  :requirements nil})))
          {:errors
             ((core/vec::append profile-errors)
               ((core/map::get parsed) (quote :errors)))
            :path path
            :requirements ((core/map::get parsed) (quote :requirements))})
        {:errors ["profile negotiation requires map-shaped ::meta"]
          :path path
          :requirements nil}))))

(def selfhost/typecheck::collect-profile-requirements
  (fn (modules)
    (((selfhost/typecheck::collect-profile-requirements-loop modules)
