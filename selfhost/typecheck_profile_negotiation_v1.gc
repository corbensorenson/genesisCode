(def selfhost/typecheck::select-profile
  (fn (family)
    (fn (requirement)
      (let
        ((mode ((core/map::get requirement) (quote :mode)))
          (required ((core/map::get requirement) (quote :profile)))
          (lineage ((core/map::get selfhost/typecheck::profile-lineages) family))
          (offered ((core/map::get selfhost/typecheck::core-profile-offer) family)))
        (let
          ((selected
             (if ((core/sym::eq? mode) (quote exact))
               (if ((selfhost/typecheck::vec-contains? offered) required) required nil)
               (((selfhost/typecheck::select-profile-minimum lineage) offered) required))))
          (if (selfhost/typecheck::nil? selected)
            (selfhost/typecheck::err
              ((selfhost/typecheck::str4 "unsupported "
                 (selfhost/typecheck::symbol-str mode))
                " profile requirement "
                ((selfhost/typecheck::str4
                   (selfhost/typecheck::symbol-str required))
                  " in family "
                  ((selfhost/typecheck::str2 (selfhost/typecheck::symbol-str family))
                    ((selfhost/typecheck::str2 "; offered [")
                      ((selfhost/typecheck::str2
                         ((core/str::join
                            (selfhost/typecheck::vec-map
                              offered selfhost/typecheck::symbol-str))
                           ", "))
                        "]"))))))
            (selfhost/typecheck::ok selected)))))))

