        (workspace-path ((core/map::get request) (quote :workspace-file)))
        (registry ((core/map::get request) (quote :registry-default)))
        (dependencies ((core/map::get request) (quote :dependencies))))
      (if (((selfhost/pkg-scaffold::optional-bounded-str? workspace) 1024))
        (if
          (if (core/list::is-nil? workspace)
            true
            ((core/int::lt? 0) (core/str::len workspace)))
          (if (selfhost/pkg-scaffold::nonempty-str? package-name)
