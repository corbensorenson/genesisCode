(def core/pkg::workspace-migrate-authority
  (fn (request)
    (let ((request-h (selfhost/hash::hash-term request)))
      (if (selfhost/pkg-scaffold::map? request)
        (if
          ((selfhost/pkg-lock-read::exact-map? request)
            [:dependencies :kind :lock :member-path :package-name :package-path
             :registry-default :v :workspace :workspace-file])
          (if
            (if
              (if (selfhost/pkg-lock-read::str?
                    ((core/map::get request) (quote :kind)))
                ((core/eq? ((core/map::get request) (quote :kind)))
                  selfhost/pkg-workspace-migrate::request-kind)
                false)
              (if (selfhost/pkg-lock-read::int?
                    ((core/map::get request) (quote :v)))
                ((core/int::eq? ((core/map::get request) (quote :v))) 1)
                false)
              false)
            (if (selfhost/pkg-workspace-migrate::request-values-valid? request)
              (let
                ((requirements
                  (selfhost/pkg-workspace-migrate::requirements
                    ((core/map::get request) (quote :dependencies)))))
                (if ((core/map::get requirements) (quote :ok))
                  (((selfhost/pkg-workspace-migrate::finish request-h) request) requirements)
                  ((selfhost/pkg-workspace-migrate::reject request-h)
                    "dependency fields are malformed")))
              ((selfhost/pkg-workspace-migrate::reject request-h)
                "migration request values are invalid"))
            ((selfhost/pkg-workspace-migrate::reject request-h)
              "migration request kind or version mismatch"))
          ((selfhost/pkg-workspace-migrate::reject request-h)
            "migration request fields mismatch"))
        ((selfhost/pkg-workspace-migrate::reject request-h)
          "migration request must be map")))))
