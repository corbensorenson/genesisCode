(def selfhost/pkg-publish-authority::set-overlap-loop?
  (fn (entries)
    (fn (right)
      (fn (index)
        (if ((core/int::eq? index) (core/vec::len entries))
          false
          (let ((pk ((core/vec::get ((core/vec::get entries) index)) 0)))
            (if ((selfhost/pkg-publish-authority::has-key? right) pk)
