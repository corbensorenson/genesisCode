(def selfhost/pkg-publish-authority::independence-code-loop
  (fn (pairs)
    (fn (role-signers)
      (fn (index)
        (if ((core/int::eq? index) (core/vec::len pairs))
          nil
          (let ((pair ((core/vec::get pairs) index)))
            (let
              ((left-role ((selfhost/pkg-publish-authority::field pair) (quote :left)))
                (right-role ((selfhost/pkg-publish-authority::field pair) (quote :right))))
              (let
                ((left ((selfhost/pkg-publish-authority::field role-signers) left-role))
                  (right ((selfhost/pkg-publish-authority::field role-signers) right-role)))
                (if
                  (if (selfhost/pkg-publish-authority::map? left)
                    ((core/int::lt? 0) (core/map::len left))
                    false)
                  (if
                    (if (selfhost/pkg-publish-authority::map? right)
                      ((core/int::lt? 0) (core/map::len right))
                      false)
                    (if ((selfhost/pkg-publish-authority::sets-overlap? left) right)
