(def selfhost/pkg-publish-authority::role-signer-count
  (fn (role-signers)
    (fn (role)
      (let ((signers ((selfhost/pkg-publish-authority::field role-signers) role)))
        (if (selfhost/pkg-publish-authority::map? signers) (core/map::len signers) 0)))))

(def selfhost/pkg-publish-authority::required-role-code-loop
  (fn (roles)
    (fn (role-signers)
      (fn (index)
        (if ((core/int::eq? index) (core/vec::len roles))
          nil
          (if
            ((core/int::lt? 0)
              ((selfhost/pkg-publish-authority::role-signer-count role-signers)
                ((core/vec::get roles) index)))
            (((selfhost/pkg-publish-authority::required-role-code-loop roles) role-signers)
              ((core/int::add index) 1))
            "core/pkg/missing-attestation-role"))))))

(def selfhost/pkg-publish-authority::role-minimum-code-loop
  (fn (entries)
    (fn (role-signers)
      (fn (index)
        (if ((core/int::eq? index) (core/vec::len entries))
          nil
          (let ((entry ((core/vec::get entries) index)))
            (let ((role ((core/vec::get entry) 0)) (minimum ((core/vec::get entry) 1)))
              (if
                ((core/int::lt? ((selfhost/pkg-publish-authority::role-signer-count role-signers) role))
                  minimum)
                "core/pkg/missing-attestation-role-signatures"
                (((selfhost/pkg-publish-authority::role-minimum-code-loop entries) role-signers)
