(def selfhost/pkg-publish-authority::sets-overlap?
  (fn (left)
    (fn (right)
      (if (selfhost/pkg-publish-authority::map? left)
        (if (selfhost/pkg-publish-authority::map? right)
          (((selfhost/pkg-publish-authority::set-overlap-loop? (core/map::entries left)) right) 0)
