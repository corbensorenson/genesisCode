                      (((selfhost/pkg-publish-authority::independence-code-loop pairs) role-signers)
                        ((core/int::add index) 1)))
                    "core/pkg/missing-attestation-role")
                  "core/pkg/missing-attestation-role")))))))))

(def selfhost/pkg-publish-authority::signature-policy-code
  (fn (class)
    (fn (tally)
      (let
        ((signers ((selfhost/pkg-publish-authority::field tally) (quote :signers)))
          (role-signers ((selfhost/pkg-publish-authority::field tally) (quote :role-signers))))
        (if
          ((core/int::lt? (core/map::len signers))
            ((selfhost/pkg-publish-authority::field class) (quote :min-signatures)))
          "core/pkg/missing-signatures"
          (let
            (
              (required-code
                (
                  (
                    (selfhost/pkg-publish-authority::required-role-code-loop
