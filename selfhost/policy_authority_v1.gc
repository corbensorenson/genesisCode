(def selfhost/policy::find-alias
  (fn (aliases)
    (fn (name)
      ((((selfhost/policy::find-alias-loop aliases) name) (core/vec::len aliases)) 0))))

(def selfhost/policy::find-alias-loop
  (fn (aliases)
    (fn (name)
      (fn (count)
        (fn (index)
          (if ((core/int::eq? index) count)
            nil
            (if ((core/eq? ((selfhost/policy::alias-name-at aliases) index)) name)
              ((selfhost/policy::alias-hash-at aliases) index)
              ((((selfhost/policy::find-alias-loop aliases) name) count)
                ((core/int::add index) 1)))))))))

(def selfhost/policy::normalize-aliases
  (fn (aliases)
    (if (selfhost/policy::vec? aliases)
      ((((selfhost/policy::normalize-aliases-loop aliases) (core/vec::len aliases)) 0) [])
      (selfhost/policy::error ":aliases must be a vector"))))

(def selfhost/policy::normalize-aliases-loop
  (fn (aliases)
    (fn (count)
      (fn (index)
        (fn (out)
          (if ((core/int::eq? index) count)
            out
            (let ((entry ((core/vec::get aliases) index)))
              (if (selfhost/policy::map? entry)
                (if ((core/int::eq? (core/map::len entry)) 2)
                  (let
                    ((name0 ((core/map::get entry) (quote :name)))
                      (hash0 ((core/map::get entry) (quote :hash))))
                    (if (if (selfhost/policy::str? name0) (selfhost/policy::str? hash0) false)
                      (let ((name (selfhost/policy::trim name0)))
                        (let ((hash (selfhost/policy::normalize-hash (selfhost/policy::trim hash0))))
                        (if (selfhost/policy::nil? hash)
                          (selfhost/policy::error "policy alias hash must be 64-hex")
                          (if (selfhost/policy::non-empty-str? name)
                            (if (selfhost/policy::nil? ((selfhost/policy::find-alias out) name))
                              ((((selfhost/policy::normalize-aliases-loop aliases) count)
                                 ((core/int::add index) 1))
                                ((core/vec::push out) {:hash hash :name name}))
                              (selfhost/policy::error "duplicate policy alias"))
                            (selfhost/policy::error "policy alias name must be non-empty")))))
                      (selfhost/policy::error "policy alias name and hash must be strings")))
                  (selfhost/policy::error "policy alias entry must contain exactly :name and :hash"))
                (selfhost/policy::error "policy alias entry must be a map")))))))))

(def selfhost/policy::normalize-default
  (fn (selector)
    (if (selfhost/policy::nil? selector)
      nil
      (if (selfhost/policy::str? selector)
        (let ((trimmed (selfhost/policy::trim selector)))
          (if (selfhost/policy::non-empty-str? trimmed)
            (let ((hash (selfhost/policy::normalize-hash trimmed)))
              (if (selfhost/policy::nil? hash) trimmed hash))
            (selfhost/policy::error "default policy selector must be a non-empty string or nil")))
        (selfhost/policy::error "default policy selector must be a non-empty string or nil")))))

(def selfhost/policy::normalize-config
  (fn (config)
    (if (selfhost/policy::map? config)
      (if ((core/int::eq? (core/map::len config)) 3)
        (let
          ((version ((core/map::get config) (quote :version)))
            (default0 ((core/map::get config) (quote :default)))
            (aliases0 ((core/map::get config) (quote :aliases))))
          (if (if (selfhost/policy::int? version) ((core/int::eq? version) 1) false)
            (let ((default (selfhost/policy::normalize-default default0)))
              (if (core/error::is? default)
                default
                (let ((aliases (selfhost/policy::normalize-aliases aliases0)))
                  (if (core/error::is? aliases)
                    aliases
                    {:aliases aliases :default default :version 1}))))
            (selfhost/policy::error "unsupported policies config version")))
        (selfhost/policy::error "policy config must contain exactly :version, :default, and :aliases"))
      (selfhost/policy::error "policy config must be a map"))))

(def selfhost/policy::resolve
  (fn (config)
    (fn (selector0)
      (if (selfhost/policy::str? selector0)
        (let ((selector1 (selfhost/policy::trim selector0)))
          (if (selfhost/policy::non-empty-str? selector1)
          (let
          ((aliases ((core/map::get config) (quote :aliases)))
            (default ((core/map::get config) (quote :default))))
          (let ((selector (if ((core/eq? selector1) "default") default selector1)))
            (if (selfhost/policy::non-empty-str? selector)
              (if ((core/eq? selector) "default")
                (selfhost/policy::error "default policy selector cannot resolve to itself")
                (let ((hash (selfhost/policy::normalize-hash selector)))
                  (if (selfhost/policy::nil? hash)
                    (let ((alias-hash ((selfhost/policy::find-alias aliases) selector)))
                      (if (selfhost/policy::nil? alias-hash)
                        (selfhost/policy::error "unknown policy alias")
                        {:hash alias-hash :resolved selector}))
                    {:hash hash :resolved hash})))
              (selfhost/policy::error "no default policy configured"))))
          (selfhost/policy::error "policy selector must be non-empty")))
        (selfhost/policy::error "policy selector must be non-empty")))))

(def selfhost/policy::list-result
