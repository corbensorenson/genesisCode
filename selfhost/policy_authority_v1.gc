          (if ((core/int::eq? b0) 226)
            (if ((core/int::eq? b1) 128)
              (if (if ((core/int::lt? 127) b2) ((core/int::lt? b2) 139) false)
                true
                (if ((core/int::eq? b2) 168)
                  true
                  (if ((core/int::eq? b2) 169) true ((core/int::eq? b2) 175))))
              (if ((core/int::eq? b1) 129) ((core/int::eq? b2) 159) false))
            (if ((core/int::eq? b0) 227)
              (if ((core/int::eq? b1) 128) ((core/int::eq? b2) 128) false)
              false)))))))

(def selfhost/policy::whitespace-width-at
