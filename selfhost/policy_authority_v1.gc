(def core/cli::policy-authority
  (fn (request)
    (if (selfhost/policy::map? request)
      (if ((core/int::eq? (core/map::len request)) 5)
        (let
          ((kind ((core/map::get request) (quote :kind)))
            (version ((core/map::get request) (quote :v)))
            (operation ((core/map::get request) (quote :operation)))
            (config0 ((core/map::get request) (quote :config)))
            (selector ((core/map::get request) (quote :selector))))
          (if (if ((core/eq? kind) "genesis/policy-authority-request-v0.1")
                (if (selfhost/policy::int? version) ((core/int::eq? version) 1) false)
                false)
            (if (selfhost/policy::operation? operation)
              (let ((config (selfhost/policy::normalize-config config0)))
                (if (core/error::is? config)
                  (((selfhost/policy::failure operation) "policy/parse") config)
                  (if ((core/sym::eq? operation) (quote :list))
                    (if (selfhost/policy::nil? selector)
                      (selfhost/policy::list-result config)
                      (selfhost/policy::error ":list requires nil :selector"))
                    (if ((core/sym::eq? operation) (quote :resolve))
                      ((selfhost/policy::resolve-result config) selector)
                      ((selfhost/policy::set-default-result config) selector)))))
              (selfhost/policy::error "unknown policy authority operation"))
            (selfhost/policy::error "policy authority request identity mismatch")))
        (selfhost/policy::error "policy authority request must contain exactly five fields"))
      (selfhost/policy::error "policy authority request must be a map"))))
