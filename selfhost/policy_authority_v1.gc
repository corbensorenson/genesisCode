; Unicode White_Space under the frozen text profile, encoded as UTF-8 widths.
(def selfhost/policy::ascii-whitespace?
  (fn (byte)
    (if ((core/int::eq? byte) 32)
      true
      (if ((core/int::eq? byte) 9)
        true
        (if ((core/int::eq? byte) 10)
          true
          (if ((core/int::eq? byte) 11)
            true
            (if ((core/int::eq? byte) 12) true ((core/int::eq? byte) 13))))))))

(def selfhost/policy::three-byte-whitespace?
