(def selfhost/policy::trim
  (fn (value)
    (let ((bytes (core/str::to-utf8 value)))
      (let ((start ((selfhost/policy::trim-start bytes) 0)))
        (let ((end (((selfhost/policy::trim-end bytes) start) start)))
          (core/str::from-utf8
            (((core/bytes::slice bytes) start) ((core/int::sub end) start))))))))

; Decode any case-insensitive 64-hex selector and emit its canonical lowercase form.
(def selfhost/policy::normalize-hash
  (fn (value)
    (if (selfhost/policy::str? value)
      (let ((decoded (core/bytes::from-hex value)))
        (if (core/error::is? decoded)
          nil
          (if ((core/int::eq? (core/bytes::len decoded)) 32)
            (core/bytes::to-hex decoded)
            nil)))
      nil)))

(def selfhost/policy::alias-name-at
  (fn (aliases)
    (fn (index)
      ((core/map::get ((core/vec::get aliases) index)) (quote :name)))))

(def selfhost/policy::alias-hash-at
