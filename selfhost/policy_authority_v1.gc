        (if (selfhost/policy::ascii-whitespace? b0)
          1
          (let ((remaining ((core/int::sub (core/bytes::len bytes)) index)))
            (if ((core/int::lt? remaining) 2)
              0
              (let ((b1 ((core/bytes::get bytes) ((core/int::add index) 1))))
                (if ((core/int::eq? b0) 194)
                  (if (if ((core/int::eq? b1) 133) true ((core/int::eq? b1) 160)) 2 0)
                  (if ((core/int::lt? remaining) 3)
                    0
                    (let ((b2 ((core/bytes::get bytes) ((core/int::add index) 2))))
                      (if (((selfhost/policy::three-byte-whitespace? b0) b1) b2) 3 0))))))))))))

(def selfhost/policy::trim-start
