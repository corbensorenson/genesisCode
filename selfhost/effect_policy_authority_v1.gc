(def core/effects::policy-authority
  (fn (request)
    (if (selfhost/policy::map? request)
      (if ((core/int::eq? (core/map::len request)) 6)
        (let
          ((kind ((core/map::get request) (quote :kind)))
            (version ((core/map::get request) (quote :v)))
            (baseline ((core/map::get request) (quote :baseline)))
            (op ((core/map::get request) (quote :op)))
            (override ((core/map::get request) (quote :override)))
            (platform-max ((core/map::get request) (quote :platform-max-bytes))))
          (if
              (if ((core/eq? kind) "genesis/effect-policy-authority-request-v0.12")
              (if (selfhost/policy::int? version) ((core/int::eq? version) 12) false)
              false)
            (if
              (if (selfhost/policy::vec? baseline)
                (if (selfhost/policy::str? op)
                  (if (selfhost/policy::int? platform-max)
                    ((core/int::lt? 0) platform-max)
                    false)
                  false)
                false)
              (if (selfhost/effect-policy::override-valid? override)
                (let ((allowed (((selfhost/effect-policy::allowed? baseline) op) override)))
                  (if (core/error::is? allowed)
                    allowed
                    {
                      :allowed allowed
                      :base-dir
                        (if allowed
                          (if (selfhost/policy::nil? override)
                            nil
                            ((core/map::get override) (quote :base-dir)))
                          nil)
                      :bridge-identity-policy
                        (if allowed
                          ((selfhost/effect-bridge::policy op) override)
                          nil)
                      :cap (if allowed ((selfhost/effect-policy::cap op) override) nil)
                      :crypto-policy
                        (if allowed
                          ((selfhost/effect-crypto::policy override) platform-max)
                          nil)
                      :database-policy
                        (if allowed
                          ((selfhost/effect-policy::database-policy override) platform-max)
                          nil)
                      :ffi-policy
                        (if allowed
                          ((selfhost/effect-ffi::policy override) platform-max)
                          nil)
                      :kind "genesis/effect-policy-authority-result-v0.12"
                      :max-bytes-policy
                        (if allowed
                          ((selfhost/effect-policy::max-bytes-policy override) platform-max)
                          nil)
                      :network-policy
                        (if allowed
                          ((selfhost/effect-network::policy override) platform-max)
                          nil)
                      :op op
                      :plugin-policy
                        (if allowed
                          (selfhost/effect-plugin::policy override)
                          nil)
                      :process-program-policy
                        (if allowed
                          (selfhost/effect-policy::process-program-policy override)
                          nil)
                      :request-h (selfhost/hash::hash-term request)
                      :v 12}))
                ((core/error::make2 "core/policy/authority")
                  "effect-policy override must contain exactly the closed typed policy fields"))
              ((core/error::make2 "core/policy/authority")
                "effect-policy baseline/op/platform inputs are invalid"))
            ((core/error::make2 "core/policy/authority")
              "effect-policy authority request identity mismatch")))
        ((core/error::make2 "core/policy/authority")
