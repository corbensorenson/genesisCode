(def selfhost/effect-ffi::fields
  [
    :abi-ids
    :evidence-mode
    :libraries
    :max-buffer-bytes
    :max-call-payload-bytes
    :policy-artifact-h
    :policy-key-id
    :policy-signature-h
    :schema-ids
    :signed-policy-required
    :symbols])

(def selfhost/effect-ffi::input-valid?
  (fn (value)
    (if ((selfhost/effect-plugin::exact-map? value) selfhost/effect-ffi::fields)
      (if (selfhost/effect-plugin::list-input?
            ((core/map::get value) (quote :abi-ids)))
        (if (selfhost/effect-plugin::list-input?
              ((core/map::get value) (quote :libraries)))
          (if (selfhost/effect-plugin::list-input?
                ((core/map::get value) (quote :schema-ids)))
            (if (selfhost/effect-plugin::list-input?
                  ((core/map::get value) (quote :symbols)))
              (if (selfhost/effect-crypto::limit-input?
                    ((core/map::get value) (quote :max-buffer-bytes)))
                (if (selfhost/effect-crypto::limit-input?
                      ((core/map::get value) (quote :max-call-payload-bytes)))
                  (if (selfhost/effect-network::optional-string-input?
                        ((core/map::get value) (quote :policy-artifact-h)))
                    (if (selfhost/effect-network::optional-string-input?
                          ((core/map::get value) (quote :policy-signature-h)))
                      (if (selfhost/effect-network::optional-string-input?
                            ((core/map::get value) (quote :policy-key-id)))
                        (if (selfhost/effect-network::optional-string-input?
                              ((core/map::get value) (quote :evidence-mode)))
                          ((core/sym::eq?
                             (core/data::tag
                               ((core/map::get value)
                                 (quote :signed-policy-required))))
                            (quote :bool))
                          false)
                        false)
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)
        false)
      false)))

(def selfhost/effect-ffi::empty-input
  {
    :abi-ids nil
    :evidence-mode nil
    :libraries nil
    :max-buffer-bytes nil
    :max-call-payload-bytes nil
    :policy-artifact-h nil
    :policy-key-id nil
    :policy-signature-h nil
    :schema-ids nil
    :signed-policy-required false
    :symbols nil})

(def selfhost/effect-ffi::signed-error
  (fn (status)
    {
      :evidence-mode nil
      :policy-artifact-h nil
      :policy-key-id nil
      :policy-signature-h nil
      :status status}))

(def selfhost/effect-ffi::signed-valid
  (fn (artifact)
    (fn (signature)
      (fn (key-id)
        (fn (evidence-mode)
          {
            :evidence-mode evidence-mode
            :policy-artifact-h artifact
            :policy-key-id key-id
            :policy-signature-h signature
            :status (quote :valid)})))))

(def selfhost/effect-ffi::state-status?
  (fn (state)
    (fn (status)
      ((core/sym::eq? ((core/map::get state) (quote :status))) status))))

(def selfhost/effect-ffi::hex64?
  (fn (value)
    (if (selfhost/policy::str? value)
      (let ((decoded (core/bytes::from-hex value)))
        (if (core/error::is? decoded)
          false
          ((core/int::eq? (core/bytes::len decoded)) 32)))
      false)))

(def selfhost/effect-ffi::signed-policy
  (fn (ffi)
    (let ((required ((core/map::get ffi) (quote :signed-policy-required))))
      (if (selfhost/effect-network::invalid-type? required)
        (selfhost/effect-ffi::signed-error (quote :invalid-required-type))
        (if required
          (let ((artifact-state
                  (selfhost/effect-network::string-policy
                    ((core/map::get ffi) (quote :policy-artifact-h)))))
            (if
              (if
                ((selfhost/effect-ffi::state-status? artifact-state) (quote :absent))
                true
                ((selfhost/effect-ffi::state-status? artifact-state)
                  (quote :invalid-type)))
              (selfhost/effect-ffi::signed-error (quote :missing-artifact-h))
              (if
                ((selfhost/effect-ffi::state-status? artifact-state) (quote :empty))
                (selfhost/effect-ffi::signed-error (quote :empty-artifact-h))
                (let ((artifact ((core/map::get artifact-state) (quote :value))))
                  (if (selfhost/effect-ffi::hex64? artifact)
                    (let ((signature-state
                            (selfhost/effect-network::string-policy
                              ((core/map::get ffi) (quote :policy-signature-h)))))
                      (if
                        (if
                          ((selfhost/effect-ffi::state-status? signature-state)
                            (quote :absent))
                          true
                          ((selfhost/effect-ffi::state-status? signature-state)
                            (quote :invalid-type)))
                        (selfhost/effect-ffi::signed-error (quote :missing-signature-h))
                        (if
                          ((selfhost/effect-ffi::state-status? signature-state) (quote :empty))
                          (selfhost/effect-ffi::signed-error (quote :empty-signature-h))
                          (let ((signature
                                  ((core/map::get signature-state) (quote :value))))
                            (if (selfhost/effect-ffi::hex64? signature)
                              (let ((key-state
                                      (selfhost/effect-network::string-policy
                                        ((core/map::get ffi) (quote :policy-key-id)))))
                                (if
                                  (if
                                    ((selfhost/effect-ffi::state-status? key-state)
                                      (quote :absent))
                                    true
                                    ((selfhost/effect-ffi::state-status? key-state)
                                      (quote :invalid-type)))
                                  (selfhost/effect-ffi::signed-error (quote :missing-key-id))
                                  (if
                                    ((selfhost/effect-ffi::state-status? key-state) (quote :empty))
                                    (selfhost/effect-ffi::signed-error (quote :empty-key-id))
                                    (let ((evidence-state
                                            (selfhost/effect-network::string-policy
                                              ((core/map::get ffi) (quote :evidence-mode)))))
                                      (if
                                        (if
                                          ((selfhost/effect-ffi::state-status? evidence-state)
                                            (quote :absent))
                                          true
                                          ((selfhost/effect-ffi::state-status? evidence-state)
                                            (quote :invalid-type)))
                                        (selfhost/effect-ffi::signed-error
                                          (quote :missing-evidence-mode))
                                        (if
                                          ((selfhost/effect-ffi::state-status? evidence-state)
                                            (quote :empty))
                                          (selfhost/effect-ffi::signed-error
                                            (quote :empty-evidence-mode))
                                          (let ((evidence
                                                  ((core/map::get evidence-state) (quote :value))))
                                            (if ((core/eq? evidence) "deterministic")
                                              ((((selfhost/effect-ffi::signed-valid artifact)
                                                  signature)
                                                ((core/map::get key-state) (quote :value)))
                                              evidence)
                                              (selfhost/effect-ffi::signed-error
                                                (quote :invalid-evidence-mode))))))))))
                              (selfhost/effect-ffi::signed-error
                                (quote :invalid-signature-h)))))))
                    (selfhost/effect-ffi::signed-error (quote :invalid-artifact-h)))))))
          (selfhost/effect-ffi::signed-error (quote :disabled)))))))

(def selfhost/effect-ffi::policy
  (fn (override)
    (fn (platform-max)
      (let ((ffi
        (if (selfhost/policy::nil? override)
          selfhost/effect-ffi::empty-input
          ((core/map::get override) (quote :ffi-policy)))))
        {
          :abi-ids
            (selfhost/effect-plugin::list-policy
              ((core/map::get ffi) (quote :abi-ids)))
          :libraries
            (selfhost/effect-plugin::list-policy
              ((core/map::get ffi) (quote :libraries)))
          :max-buffer-bytes
            ((selfhost/effect-crypto::positive-limit-policy
               ((core/map::get ffi) (quote :max-buffer-bytes))) platform-max)
          :max-call-payload-bytes
            ((selfhost/effect-crypto::positive-limit-policy
               ((core/map::get ffi) (quote :max-call-payload-bytes))) platform-max)
          :schema-ids
            (selfhost/effect-plugin::list-policy
              ((core/map::get ffi) (quote :schema-ids)))
          :signed-policy (selfhost/effect-ffi::signed-policy ffi)
          :symbols
            (selfhost/effect-plugin::list-policy
              ((core/map::get ffi) (quote :symbols)))}))))
