  (fn (package)
    (fn (inputs)
      (if ((selfhost/obligation::property-exact-map? inputs)
            [:configured :default-cases :outcomes :phase :suites])
        (if ((core/sym::eq? ((core/map::get inputs) (quote :phase))) (quote :finalize))
          (let ((configured ((core/map::get inputs) (quote :configured)))
                (default-cases ((core/map::get inputs) (quote :default-cases)))
                (suites ((core/map::get inputs) (quote :suites)))
                (outcomes ((core/map::get inputs) (quote :outcomes))))
            (let ((plan ((((selfhost/obligation::property-plan-state package) configured)
                          default-cases) suites)))
              (if (core/error::is? plan)
                plan
                (if (selfhost/obligation::vec? outcomes)
                  (let ((tests ((core/map::get plan) (quote :tests)))
                        (plan-errors ((core/map::get plan) (quote :errors))))
                    (let ((final-state (((((selfhost/obligation::property-finalize-loop tests)
                                            outcomes) 0) []) [])))
                      (if (core/error::is? final-state)
                        final-state
                        (let ((reports ((core/map::get final-state) (quote :reports)))
                              (outcome-errors ((core/map::get final-state) (quote :errors))))
                          (let ((errors ((selfhost/obligation::append-errors plan-errors)
                                         outcome-errors)))
                            (let ((ok ((core/int::eq? (core/vec::len errors)) 0)))
                              {:errors errors
                               :kind selfhost/obligation::RESULT_KIND
                               :name "core/obligation::property-tests"
                               :ok ok
                               :operation (quote :property-tests)
                               :report
                                 (if configured
                                   (let ((base
                                          {:config {:cases-per-test default-cases}
                                           :kind "genesis/property-tests-v0.2"
                                           :ok ok
                                           :package package
                                           :tests reports}))
                                     (if ok base (((core/map::put base) (quote :errors)) errors)))
                                   {:kind "genesis/property-tests-v0.2"
                                    :note "no property tests"
                                    :ok true
                                    :package package})
                               :v 2}))))))
                  (selfhost/obligation::error ":outcomes must be a vector")))))
          (selfhost/obligation::error "property finalize request :phase must be :finalize"))
        (selfhost/obligation::error "property finalize inputs must contain exactly :configured, :default-cases, :outcomes, :phase, and :suites")))))

(def selfhost/obligation::property-authority
  (fn (package)
    (fn (inputs)
      (let ((phase ((core/map::get inputs) (quote :phase))))
        (if (if (selfhost/obligation::sym? phase)
              ((core/sym::eq? phase) (quote :plan))
              false)
          ((selfhost/obligation::property-plan package) inputs)
          ((selfhost/obligation::property-finalize package) inputs))))))
