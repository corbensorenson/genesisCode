                {:errors
                   (((selfhost/typecheck::module-error-add errors) path)
                     ((selfhost/typecheck::str2
                        (selfhost/typecheck::symbol-str field))
                       " must be a vector of symbols"))
                 :set {}}))
            {:errors
               (((selfhost/typecheck::module-error-add errors) path)
                 ((selfhost/typecheck::str2 "module-resolution profile requires ")
                   (selfhost/typecheck::symbol-str field)))
             :set {}}))))))

(def selfhost/typecheck::parse-unique-symbol-vector-loop
  (fn (items)
    (fn (field)
      (fn (path)
        (fn (i)
          (fn (state)
            (if ((core/int::eq? i) (core/vec::len items))
              state
              (let ((item ((core/vec::get items) i)))
                (let
                  ((state2
                     (if (selfhost/typecheck::sym? item)
                       (let
                         ((duplicate
                            ((selfhost/typecheck::set-has?
                               ((core/map::get state) (quote :set)))
                              item))
                           (valid (selfhost/typecheck::validate-qualified-symbol item)))
                         {:errors
                            (let
                              ((with-duplicate
                                 (if duplicate
                                   (((selfhost/typecheck::module-error-add
                                        ((core/map::get state) (quote :errors)))
                                       path)
                                     ((selfhost/typecheck::str4 "duplicate "
                                        (selfhost/typecheck::symbol-str field))
                                       " entry "
                                       (selfhost/typecheck::symbol-str item)))
                                   ((core/map::get state) (quote :errors)))))
                              (if (selfhost/typecheck::result-ok? valid)
                                with-duplicate
                                (((selfhost/typecheck::module-error-add with-duplicate) path)
                                  ((selfhost/typecheck::str4 "invalid "
                                     (selfhost/typecheck::symbol-str field))
                                    ((selfhost/typecheck::str2 " entry ")
                                      (selfhost/typecheck::symbol-str item))
                                    ((selfhost/typecheck::str2 ": ")
                                      ((core/map::get valid) (quote :error)))))))
                          :set
                            ((selfhost/typecheck::set-add
                               ((core/map::get state) (quote :set)))
                              item)})
                       {:errors
                          (((selfhost/typecheck::module-error-add
                               ((core/map::get state) (quote :errors)))
                              path)
                            ((selfhost/typecheck::str2
                               (selfhost/typecheck::symbol-str field))
                              " entries must be symbols"))
                        :set ((core/map::get state) (quote :set))})))
                  (((((selfhost/typecheck::parse-unique-symbol-vector-loop items) field)
                      path)
                     ((core/int::add i) 1))
                    state2))))))))))

(def selfhost/typecheck::parse-required-profiles
  (fn (meta)
    (fn (path)
      (fn (errors)
        (if ((selfhost/typecheck::map-has-key? meta) (quote :requires-profiles))
          (let ((value ((core/map::get meta) (quote :requires-profiles))))
            (if (selfhost/typecheck::map? value)
              (let
                ((parsed
                   ((selfhost/typecheck::symbol-map-or-error value)
                     ":requires-profiles must be a symbol-to-symbol map")))
                (let
                  ((errors2
                     (if (selfhost/typecheck::result-ok? parsed)
                       errors
                       (((selfhost/typecheck::module-error-add errors) path)
                         ((core/map::get parsed) (quote :error)))))
                    (profiles
                      (if (selfhost/typecheck::result-ok? parsed)
                        ((core/map::get parsed) (quote :value))
                        {})))
                  {:errors
                     (if (selfhost/typecheck::required-profiles-exact? profiles)
                       errors2
                       (((selfhost/typecheck::module-error-add errors2) path)
                         selfhost/typecheck::module-required-profiles-message))
                   :profiles profiles}))
              {:errors
                 (((selfhost/typecheck::module-error-add errors) path)
                   ":requires-profiles must be a symbol-to-symbol map")
               :profiles {}}))
          {:errors
             (((selfhost/typecheck::module-error-add errors) path)
               "module-resolution profile requires :requires-profiles")
           :profiles {}})))))

