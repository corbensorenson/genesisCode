(def selfhost/typecheck::parse-module-descriptor
  (fn (module)
    (fn (errors)
      (let
        ((path ((core/map::get module) (quote :path)))
          (meta ((core/map::get module) (quote :meta))))
        (if (selfhost/typecheck::map? meta)
          (let
            ((errors1
               (if ((selfhost/typecheck::map-has-key? meta) (quote :module-profile))
                 (let ((profile ((core/map::get meta) (quote :module-profile))))
                   (if
                     (if (selfhost/typecheck::sym? profile)
                       ((core/sym::eq? profile)
                         selfhost/typecheck::module-resolution-profile)
                       false)
                     errors
                     (((selfhost/typecheck::module-error-add errors) path)
                       ((selfhost/typecheck::str4
                          ":module-profile must be exact symbol genesis/module-resolution-profile-v0.1, got "
                          (selfhost/typecheck::term-str profile))
                         ""
                         ""))))
                 (((selfhost/typecheck::module-error-add errors) path)
                   "every module in the resolution closure must declare :module-profile genesis/module-resolution-profile-v0.1"))))
            (let
              ((imports
                 ((((selfhost/typecheck::parse-unique-symbol-vector meta) (quote :imports))
                    path)
                   errors1)))
              (let
                ((exports
                   ((((selfhost/typecheck::parse-unique-symbol-vector meta) (quote :exports))
                      path)
                     ((core/map::get imports) (quote :errors)))))
                (let
                  ((profiles
                     (((selfhost/typecheck::parse-required-profiles meta) path)
                       ((core/map::get exports) (quote :errors)))))
                  {:descriptor
                     {:definitions
                        (selfhost/typecheck::module-definitions
                          ((core/map::get module) (quote :forms)))
                       :exports ((core/map::get exports) (quote :set))
                       :imports ((core/map::get imports) (quote :set))
                       :required-profiles
                         ((core/map::get profiles) (quote :profiles))}
                   :errors ((core/map::get profiles) (quote :errors))}))))
          {:descriptor
             {:definitions {} :exports {} :imports {} :required-profiles {}}
           :errors
             (((selfhost/typecheck::module-error-add errors) path)
               "module-resolution profile requires map-shaped ::meta")})))))

