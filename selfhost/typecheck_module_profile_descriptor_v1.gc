            (if ((core/int::eq? count) 1)
              (if ((core/int::lt? 0) position)
                ((core/int::lt? ((core/int::add position) 2)) n)
                false)
              false)
            (let ((namespace (((core/bytes::slice bytes) 0) position)))
              (if
                (if ((core/int::eq? ((core/bytes::get namespace) 0)) 47)
                  true
                  ((selfhost/typecheck::bytes-has? namespace) 92))
                (selfhost/typecheck::err
                  "namespace must be a portable slash-separated path")
                (if ((selfhost/typecheck::portable-components? namespace) false)
                  (selfhost/typecheck::ok symbol)
                  (selfhost/typecheck::err
                    "namespace must be a portable slash-separated path"))))
            (selfhost/typecheck::err
              "namespace and name must be non-empty with exactly one '::'")))))))

(def selfhost/typecheck::parse-unique-symbol-vector
