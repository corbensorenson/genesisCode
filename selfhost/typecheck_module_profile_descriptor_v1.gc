            (quote genesis/hash-profile/gcv0.2-blake3))
          (if
            (((selfhost/typecheck::profile-binding-exact? profiles)
               (quote genesis/language-profile))
              (quote genesis/language-profile/v0.2))
            (((selfhost/typecheck::profile-binding-exact? profiles)
               (quote genesis/module-resolution-profile))
              (quote genesis/module-resolution-profile-v0.1))
