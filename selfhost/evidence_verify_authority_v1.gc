(def selfhost/evidence-verify::and (fn (left) (fn (right) (if left right false))))

(def selfhost/evidence-verify::map?
  (fn (value) ((core/sym::eq? (selfhost/evidence-verify::tag value)) (quote :map))))

(def selfhost/evidence-verify::vec?
  (fn (value) ((core/sym::eq? (selfhost/evidence-verify::tag value)) (quote :vec))))

