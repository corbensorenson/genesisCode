(def selfhost/typecheck::match-effect-row
  (fn (inferred)
    (fn (declared)
      (fn (bindings)
        (let ((tail ((core/map::get declared) (quote :tail))))
          (if (selfhost/typecheck::tail-closed? tail)
            {:bindings bindings
              :ok
                (if
                  (selfhost/typecheck::tail-closed?
                    ((core/map::get inferred) (quote :tail)))
                  ((selfhost/typecheck::set-subset?
                     ((core/map::get inferred) (quote :ops)))
                    ((core/map::get declared) (quote :ops)))
                  false)}
            (if (selfhost/typecheck::tail-any? tail)
              {:bindings bindings :ok true}
              (let
                ((remainder
                   ((selfhost/typecheck::eff-row
                      ((selfhost/typecheck::set-difference
                         ((core/map::get inferred) (quote :ops)))
                        ((core/map::get declared) (quote :ops))))
                     ((core/map::get inferred) (quote :tail))))
                  (bound ((core/map::get bindings) tail)))
                (if (selfhost/typecheck::nil? bound)
                  {:bindings (((core/map::put bindings) tail) remainder) :ok true}
                  (if
                    (if
                      (selfhost/typecheck::tail-any?
                        ((core/map::get bound) (quote :tail)))
                      true
                      (selfhost/typecheck::tail-any?
                        ((core/map::get remainder) (quote :tail))))
                    {:bindings
                       (((core/map::put bindings) tail)
                         ((selfhost/typecheck::eff-row
                            ((selfhost/typecheck::set-union
                               ((core/map::get bound) (quote :ops)))
                              ((core/map::get remainder) (quote :ops))))
                           (quote :any)))
                      :ok true}
                    {:bindings bindings :ok ((core/eq? bound) remainder)}))))))))))

(def selfhost/typecheck::apply-effect-row
