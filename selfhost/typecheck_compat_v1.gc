(def selfhost/typecheck::tail-closed?
  (fn (tail) ((core/sym::eq? tail) (quote :closed))))

(def selfhost/typecheck::tail-any?
  (fn (tail) ((core/sym::eq? tail) (quote :any))))

(def selfhost/typecheck::tail-var?
  (fn (tail)
    (if (selfhost/typecheck::tail-closed? tail)
      false
      (if (selfhost/typecheck::tail-any? tail) false true))))

(def selfhost/typecheck::effect-scan-empty {:anonymous false :vars {}})

(def selfhost/typecheck::collect-effect-tail
  (fn (tail)
    (fn (scan)
      (if (selfhost/typecheck::tail-closed? tail)
        scan
        (if (selfhost/typecheck::tail-any? tail)
          (((core/map::put scan) (quote :anonymous)) true)
          (((core/map::put scan) (quote :vars))
            ((selfhost/typecheck::set-add ((core/map::get scan) (quote :vars))) tail)))))))

(def selfhost/typecheck::collect-effect-rows
  (fn (ty)
    (fn (scan)
      (let ((tag (selfhost/typecheck::ty-tag ty)))
        (if ((core/sym::eq? tag) (quote :fn))
          (let
            ((s1
               ((selfhost/typecheck::collect-effect-tail
                  ((core/map::get ((core/map::get ty) (quote :eff))) (quote :tail)))
                 scan)))
            ((selfhost/typecheck::collect-effect-rows ((core/map::get ty) (quote :ret)))
              ((selfhost/typecheck::collect-effect-rows ((core/map::get ty) (quote :param))) s1)))
          (if ((core/sym::eq? tag) (quote :prog))
            (let
              ((s1
                 ((selfhost/typecheck::collect-effect-tail
                    ((core/map::get ((core/map::get ty) (quote :eff))) (quote :tail)))
                   scan)))
              ((selfhost/typecheck::collect-effect-rows ((core/map::get ty) (quote :ret))) s1))
            (if ((core/sym::eq? tag) (quote :msg))
              ((selfhost/typecheck::collect-effect-rows ((core/map::get ty) (quote :payload))) scan)
              (if ((core/sym::eq? tag) (quote :rec))
                (((selfhost/typecheck::collect-effect-fields
                    ((core/map::get ty) (quote :fields)))
                   (core/map::entries ((core/map::get ty) (quote :fields))))
                  scan)
                (if ((core/sym::eq? tag) (quote :contract))
                  (((selfhost/typecheck::collect-effect-fields
                      ((core/map::get ty) (quote :methods)))
                     (core/map::entries ((core/map::get ty) (quote :methods))))
                    scan)
                  scan)))))))))

(def selfhost/typecheck::collect-effect-fields
  (fn (fields)
    (fn (entries)
      (fn (scan)
        ((((selfhost/typecheck::collect-effect-fields-loop entries)
            (core/vec::len entries))
           0)
          scan)))))

(def selfhost/typecheck::collect-effect-fields-loop
  (fn (entries)
    (fn (n)
      (fn (i)
        (fn (scan)
          (if ((core/int::eq? i) n)
            scan
            (let
              ((entry ((core/vec::get entries) i)))
              ((((selfhost/typecheck::collect-effect-fields-loop entries) n)
                 ((core/int::add i) 1))
                ((selfhost/typecheck::collect-effect-rows ((core/vec::get entry) 1)) scan)))))))))

(def selfhost/typecheck::validate-effect-row-declaration
  (fn (ty)
    (fn (strict-effects)
      (let ((scan ((selfhost/typecheck::collect-effect-rows ty) selfhost/typecheck::effect-scan-empty)))
        (if
          (if strict-effects ((core/map::get scan) (quote :anonymous)) false)
          (selfhost/typecheck::err
            "strict effect mode requires a closed declared effect row or a named row variable bound by a function parameter")
          (let
            ((parameter-scan
               (if ((core/sym::eq? (selfhost/typecheck::ty-tag ty)) (quote :fn))
                 ((selfhost/typecheck::collect-effect-rows ((core/map::get ty) (quote :param)))
                   selfhost/typecheck::effect-scan-empty)
                 selfhost/typecheck::effect-scan-empty)))
            (let
              ((unbound
                 ((selfhost/typecheck::set-difference ((core/map::get scan) (quote :vars)))
                   ((core/map::get parameter-scan) (quote :vars)))))
              (let ((names (selfhost/typecheck::set-keys unbound)))
                (if ((core/int::eq? (core/vec::len names)) 0)
                  (selfhost/typecheck::ok true)
                  (selfhost/typecheck::err
                    ((selfhost/typecheck::str3 "unbound effect row variable(s) "
                       ((core/str::join
                          ((selfhost/typecheck::vec-map names) selfhost/typecheck::symbol-str))
                         ", "))
                      "; named tails must occur in the outermost function parameter")))))))))))

(def selfhost/typecheck::has-unresolved-contract-ops?
  (fn (ty)
    (let ((tag (selfhost/typecheck::ty-tag ty)))
      (if ((core/sym::eq? tag) (quote :msg))
        (if (selfhost/typecheck::nil? ((core/map::get ty) (quote :op)))
          true
          (selfhost/typecheck::has-unresolved-contract-ops?
            ((core/map::get ty) (quote :payload))))
        (if ((core/sym::eq? tag) (quote :fn))
          (if
            (selfhost/typecheck::has-unresolved-contract-ops?
              ((core/map::get ty) (quote :param)))
            true
            (selfhost/typecheck::has-unresolved-contract-ops?
              ((core/map::get ty) (quote :ret))))
          (if ((core/sym::eq? tag) (quote :prog))
            (selfhost/typecheck::has-unresolved-contract-ops?
              ((core/map::get ty) (quote :ret)))
            (if ((core/sym::eq? tag) (quote :rec))
              (selfhost/typecheck::fields-have-unresolved?
                (core/map::entries ((core/map::get ty) (quote :fields))))
              (if ((core/sym::eq? tag) (quote :contract))
                (selfhost/typecheck::fields-have-unresolved?
                  (core/map::entries ((core/map::get ty) (quote :methods))))
                false))))))))

(def selfhost/typecheck::fields-have-unresolved?
  (fn (entries)
    (((selfhost/typecheck::fields-have-unresolved-loop entries) (core/vec::len entries)) 0)))

(def selfhost/typecheck::fields-have-unresolved-loop
  (fn (entries)
    (fn (n)
      (fn (i)
        (if ((core/int::eq? i) n)
          false
          (if
            (selfhost/typecheck::has-unresolved-contract-ops?
              ((core/vec::get ((core/vec::get entries) i)) 1))
            true
            (((selfhost/typecheck::fields-have-unresolved-loop entries) n)
              ((core/int::add i) 1))))))))

(def selfhost/typecheck::bind-unknown-row
