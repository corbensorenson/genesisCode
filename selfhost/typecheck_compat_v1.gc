                            (ef ((core/map::get expected) (quote :fields))))
                          (if ((((selfhost/typecheck::shape-fields-subtype? af) ef) strict-shapes) false)
                            (((((selfhost/typecheck::shape-tail-compatible? af)
                                 ((core/map::get actual) (quote :tail)))
                                ef)
                               ((core/map::get expected) (quote :tail)))
                              strict-shapes)
                            false))
                        (if
                          (if
                            ((core/sym::eq? at) (quote :contract))
                            ((core/sym::eq? et) (quote :contract))
                            false)
                          (let
                            ((af ((core/map::get actual) (quote :methods)))
                              (ef ((core/map::get expected) (quote :methods))))
                            (if ((((selfhost/typecheck::shape-fields-subtype? af) ef) strict-shapes) true)
                              (((((selfhost/typecheck::shape-tail-compatible? af)
                                   ((core/map::get actual) (quote :tail)))
                                  ef)
                                 ((core/map::get expected) (quote :tail)))
                                strict-shapes)
                              false))
                          false)))))))))))))

(def selfhost/typecheck::type-compatible?
  (fn (inferred)
    (fn (declared)
      (fn (strict-shapes)
        (let
          ((bound (((selfhost/typecheck::bind-declared-effect-rows inferred) declared) {})))
          (if ((core/map::get bound) (quote :ok))
            (((selfhost/typecheck::type-subtype? inferred)
               ((selfhost/typecheck::apply-type-bindings declared)
                 ((core/map::get bound) (quote :bindings))))
              strict-shapes)
            false))))))
