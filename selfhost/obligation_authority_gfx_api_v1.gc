                    {:errors errors
                     :kind selfhost/obligation::RESULT_KIND
                     :name "core/obligation::gfx-api-stability"
                     :ok ok
                     :operation (quote :gfx-api-stability)
                     :report
                       {:errors errors
                        :expected-surface-h expected-surface-h
                        :kind "genesis/gfx-api-stability-v0.2"
                        :ok ok
                        :package package
                        :surface surface
                        :surface-h surface-h}
                     :v 2}))))))))))

