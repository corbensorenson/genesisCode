(def selfhost/obligation::gfx-api-finalize
  (fn (package)
    (fn (context)
      (let
        ((definition-state ((core/map::get context) (quote :definition-state)))
          (filtered-exports ((core/map::get context) (quote :filtered-exports)))
          (expected-exports ((core/map::get context) (quote :expected-exports)))
          (expected-surface-h ((core/map::get context) (quote :expected-surface-h)))
          (tracked ((core/map::get context) (quote :tracked)))
          (surface-state ((core/map::get context) (quote :surface-state))))
        (let
          ((surface
             {:defs ((core/map::get surface-state) (quote :entries))
              :exports tracked
              :kind "genesis/gfx-api-surface-v0.2"}))
          (let ((surface-h (selfhost/hash::hash-term surface)))
            (if (core/error::is? surface-h)
              surface-h
              (let
                ((analysis
                   (((((((core/gfx/obligation::api-stability-analysis filtered-exports)
                          expected-exports)
                         tracked)
                        expected-surface-h)
                       surface-h)
                      (if ((core/int::eq? (core/vec::len expected-exports)) 0)
                        (if (selfhost/obligation::nil? expected-surface-h) false true)
                        true))
                     ((core/map::get surface-state) (quote :missing)))))
                (let
