        (let
          ((definitions ((core/map::get inputs) (quote :definitions)))
            (exports ((core/map::get inputs) (quote :exports)))
            (expected-exports ((core/map::get inputs) (quote :expected-exports)))
            (expected-surface-h ((core/map::get inputs) (quote :expected-surface-h))))
