(def selfhost/pkg-workspace-task::normalize-action
  (fn (raw)
    (let
      ((cmd
        (selfhost/effect-crypto::ascii-lower (selfhost/policy::trim raw))))
      (if ((core/eq? cmd) "test")
        "test"
        (if ((core/eq? cmd) "pack")
          "pack"
          (if ((core/eq? cmd) "build")
            "pack"
            (if ((core/eq? cmd) "typecheck")
              "typecheck"
              (if ((core/eq? cmd) "lint")
                "typecheck"
                (if ((core/eq? cmd) "run")
                  "run"
                  (if ((core/eq? cmd) "bench")
                    "run"
                    (if ((core/eq? cmd) "contract")
                      "contract"
                      (if ((core/eq? cmd) "eval")
                        "eval"
                        (if ((core/eq? cmd) "fmt")
                          "fmt"
                          (if ((core/eq? cmd) "optimize") "optimize" nil))))))))))))))

(def selfhost/pkg-workspace-task::empty-action
