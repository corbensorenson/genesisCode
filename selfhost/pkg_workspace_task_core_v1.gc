(def selfhost/pkg-workspace-task::normalize-engine
  (fn (raw)
    (fn (engines)
      (let
        ((engine
          (selfhost/effect-crypto::ascii-lower (selfhost/policy::trim raw))))
        (if ((selfhost/pkg-workspace-task::member? engines) engine) engine nil)))))

(def selfhost/pkg-workspace-task::finish-args
  (fn (action)
    (fn (state)
      (if ((core/eq? action) "contract")
        (if (core/list::is-nil? ((core/map::get state) (quote :contract-h)))
          (selfhost/pkg-workspace-task::reject
            "contract task requires --contract-h <hex64>")
          (selfhost/pkg-workspace-task::accept state))
        (selfhost/pkg-workspace-task::accept state)))))

(def selfhost/pkg-workspace-task::parse-args
  (fn (action)
    (fn (args)
      (fn (engines)
        (fn (index)
          (fn (state)
            (if ((core/int::eq? index) (core/vec::len args))
              ((selfhost/pkg-workspace-task::finish-args action) state)
              (let ((arg ((core/vec::get args) index)))
                (if ((core/eq? arg) "--caps")
                  (if (selfhost/pkg-workspace-task::action-allows-caps? action)
                    (if ((selfhost/pkg-workspace-task::has-value? args) index)
                      (let ((value ((core/vec::get args) ((core/int::add index) 1))))
                        (if (selfhost/pkg-workspace-task::path-value? value)
                          (((((selfhost/pkg-workspace-task::parse-args action) args) engines)
                              ((core/int::add index) 2))
                            (((selfhost/pkg-workspace-task::put state) (quote :caps)) value))
                          (selfhost/pkg-workspace-task::reject "--caps requires a non-empty path")))
                      (selfhost/pkg-workspace-task::reject "--caps requires a value"))
                    (selfhost/pkg-workspace-task::reject "--caps is unsupported for this task action"))
                  (if ((core/eq? arg) "--log")
                    (if
                      (if ((core/eq? action) "run") true ((core/eq? action) "contract"))
                      (if ((selfhost/pkg-workspace-task::has-value? args) index)
                        (let ((value ((core/vec::get args) ((core/int::add index) 1))))
                          (if (selfhost/pkg-workspace-task::path-value? value)
                            (((((selfhost/pkg-workspace-task::parse-args action) args) engines)
                                ((core/int::add index) 2))
                              (((selfhost/pkg-workspace-task::put state) (quote :log)) value))
                            (selfhost/pkg-workspace-task::reject "--log requires a non-empty path")))
                        (selfhost/pkg-workspace-task::reject "--log requires a value"))
                      (selfhost/pkg-workspace-task::reject "--log is unsupported for this task action"))
                    (if ((core/eq? arg) "--engine")
                      (if (selfhost/pkg-workspace-task::action-allows-engine? action)
                        (if ((selfhost/pkg-workspace-task::has-value? args) index)
                          (let
                            ((engine
                              ((selfhost/pkg-workspace-task::normalize-engine
                                  ((core/vec::get args) ((core/int::add index) 1))) engines)))
                            (if (core/list::is-nil? engine)
                              (selfhost/pkg-workspace-task::reject
                                "--engine is unavailable in the active executable")
                              (((((selfhost/pkg-workspace-task::parse-args action) args) engines)
                                  ((core/int::add index) 2))
                                (((selfhost/pkg-workspace-task::put state) (quote :engine)) engine))))
                          (selfhost/pkg-workspace-task::reject "--engine requires a value"))
                        (selfhost/pkg-workspace-task::reject "--engine is unsupported for this task action"))
                      (if
                        (if ((core/eq? arg) "--contract-h")
                          true
                          ((core/eq? arg) "--contract-hash"))
                        (if ((core/eq? action) "contract")
                          (if ((selfhost/pkg-workspace-task::has-value? args) index)
                            (let
                              ((hash
                                (selfhost/effect-crypto::ascii-lower
                                  (selfhost/policy::trim
                                    ((core/vec::get args) ((core/int::add index) 1))))))
                              (if (selfhost/pkg-resolution-plan::hash64? hash)
                                (((((selfhost/pkg-workspace-task::parse-args action) args) engines)
                                    ((core/int::add index) 2))
                                  (((selfhost/pkg-workspace-task::put state) (quote :contract-h)) hash))
                                (selfhost/pkg-workspace-task::reject
                                  "--contract-h requires exactly 64 ASCII hexadecimal characters")))
                            (selfhost/pkg-workspace-task::reject "--contract-h requires a value"))
                          (selfhost/pkg-workspace-task::reject
                            "--contract-h is unsupported for this task action"))
                        (if ((core/eq? arg) "--stage1-pipeline")
                          (if ((core/eq? action) "eval")
                            (((((selfhost/pkg-workspace-task::parse-args action) args) engines)
                                ((core/int::add index) 1))
                              (((selfhost/pkg-workspace-task::put state)
                                  (quote :stage1-pipeline)) true))
                            (selfhost/pkg-workspace-task::reject
                              "--stage1-pipeline is unsupported for this task action"))
                          (if ((core/eq? arg) "--stage1-gate")
                            (if
                              (if ((core/eq? action) "eval")
                                true
                                ((core/eq? action) "optimize"))
                              (((((selfhost/pkg-workspace-task::parse-args action) args) engines)
                                  ((core/int::add index) 1))
                                (((selfhost/pkg-workspace-task::put state)
                                    (quote :stage1-gate)) true))
                              (selfhost/pkg-workspace-task::reject
                                "--stage1-gate is unsupported for this task action"))
                            (if ((core/eq? arg) "--stage2-gate")
                              (if
                                (if ((core/eq? action) "eval")
                                  true
                                  ((core/eq? action) "optimize"))
                                (((((selfhost/pkg-workspace-task::parse-args action) args) engines)
                                    ((core/int::add index) 1))
                                  (((selfhost/pkg-workspace-task::put state)
                                      (quote :stage2-gate)) true))
                                (selfhost/pkg-workspace-task::reject
                                  "--stage2-gate is unsupported for this task action"))
                              (if ((core/eq? arg) "--check")
                                (if ((core/eq? action) "fmt")
                                  (((((selfhost/pkg-workspace-task::parse-args action) args) engines)
                                      ((core/int::add index) 1))
                                    (((selfhost/pkg-workspace-task::put state) (quote :check)) true))
                                  (selfhost/pkg-workspace-task::reject
                                    "--check is unsupported for this task action"))
                                (if ((core/eq? arg) "--out")
                                  (if ((core/eq? action) "optimize")
                                    (if ((selfhost/pkg-workspace-task::has-value? args) index)
                                      (let ((value ((core/vec::get args) ((core/int::add index) 1))))
                                        (if (selfhost/pkg-workspace-task::path-value? value)
                                          (((((selfhost/pkg-workspace-task::parse-args action) args) engines)
                                              ((core/int::add index) 2))
                                            (((selfhost/pkg-workspace-task::put state) (quote :out)) value))
                                          (selfhost/pkg-workspace-task::reject
                                            "--out requires a non-empty path")))
                                      (selfhost/pkg-workspace-task::reject "--out requires a value"))
                                    (selfhost/pkg-workspace-task::reject
                                      "--out is unsupported for this task action"))
                                  (if ((core/eq? arg) "--emit-wasm")
                                    (if ((core/eq? action) "optimize")
                                      (if ((selfhost/pkg-workspace-task::has-value? args) index)
                                        (let ((value ((core/vec::get args) ((core/int::add index) 1))))
                                          (if (selfhost/pkg-workspace-task::path-value? value)
                                            (((((selfhost/pkg-workspace-task::parse-args action) args) engines)
                                                ((core/int::add index) 2))
                                              (((selfhost/pkg-workspace-task::put state)
                                                  (quote :emit-wasm)) value))
                                            (selfhost/pkg-workspace-task::reject
                                              "--emit-wasm requires a non-empty path")))
                                        (selfhost/pkg-workspace-task::reject
                                          "--emit-wasm requires a value"))
                                      (selfhost/pkg-workspace-task::reject
                                        "--emit-wasm is unsupported for this task action"))
                                    (selfhost/pkg-workspace-task::reject
                                      ((core/str::concat "unsupported workspace task argument: ") arg))))))))))))))))))))

(def selfhost/pkg-workspace-task::selected-path
  (fn (primary)
    (fn (fallback)
      (fn (default)
        (if (core/list::is-nil? primary)
          (if (core/list::is-nil? fallback) default fallback)
          primary)))))

(def selfhost/pkg-workspace-task::resolve-task
  (fn (task)
    (fn (engines)
      (let
        ((action
          (selfhost/pkg-workspace-task::normalize-action
            ((core/map::get task) (quote :cmd))))
          (task-name ((core/map::get task) (quote :name))))
        (if (core/list::is-nil? action)
          (selfhost/pkg-workspace-task::reject "unsupported workspace task command")
          (let ((state ((selfhost/pkg-workspace-task::empty-action action) task-name)))
            (if
              (if ((core/eq? action) "test")
                true
                (if ((core/eq? action) "pack") true ((core/eq? action) "typecheck")))
              (let
                ((path
                  (((selfhost/pkg-workspace-task::selected-path
                      ((core/map::get task) (quote :pkg)))
                    ((core/map::get task) (quote :file))) "package.toml")))
                (if (selfhost/pkg-workspace-task::path-value? path)
                  (((((selfhost/pkg-workspace-task::parse-args action)
                        ((core/map::get task) (quote :args))) engines) 0)
                    (((selfhost/pkg-workspace-task::put state) (quote :pkg)) path))
                  (selfhost/pkg-workspace-task::reject
                    "workspace package task requires a non-empty package path")))
              (let
                ((path
                  (((selfhost/pkg-workspace-task::selected-path
                      ((core/map::get task) (quote :file)))
                    ((core/map::get task) (quote :pkg))) nil)))
                (if (selfhost/pkg-workspace-task::path-value? path)
                  (((((selfhost/pkg-workspace-task::parse-args action)
                        ((core/map::get task) (quote :args))) engines) 0)
                    (((selfhost/pkg-workspace-task::put state) (quote :file)) path))
                  (selfhost/pkg-workspace-task::reject
                    "workspace execution task requires a non-empty file path"))))))))))

(def selfhost/pkg-workspace-task::resolve
  (fn (tasks)
    (fn (task-name)
      (fn (engines)
        (if (selfhost/pkg-workspace-task::tasks? tasks)
          (if (selfhost/pkg-workspace-task::engine-inventory? engines)
            (let ((task ((selfhost/pkg-workspace-task::find tasks) task-name)))
              (if (core/list::is-nil? task)
                (selfhost/pkg-workspace-task::reject "workspace task was not found")
                ((selfhost/pkg-workspace-task::resolve-task task) engines)))
            (selfhost/pkg-workspace-task::reject "engine inventory is invalid"))
          (selfhost/pkg-workspace-task::reject "workspace task inventory is invalid"))))))
