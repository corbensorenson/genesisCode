(def selfhost/pkg-workspace-task::accept
  (fn (value) {:message nil :ok true :value value}))

(def selfhost/pkg-workspace-task::action-allows-caps?
  (fn (action)
    (if ((core/eq? action) "test")
      true
      (if ((core/eq? action) "run") true ((core/eq? action) "contract")))))

(def selfhost/pkg-workspace-task::action-allows-engine?
  (fn (action)
    (if ((core/eq? action) "run")
      true
      (if ((core/eq? action) "contract")
        true
        (if ((core/eq? action) "eval")
          true
          (if ((core/eq? action) "fmt") true ((core/eq? action) "optimize")))))))

