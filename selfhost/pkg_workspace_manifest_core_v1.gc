; Structural workspace-manifest admission from neutral TOML terms.

(def selfhost/pkg-workspace-manifest::ok
  (fn (value) {:message nil :ok true :value value}))

(def selfhost/pkg-workspace-manifest::bad
  (fn (message) {:message message :ok false :value nil}))

(def selfhost/pkg-workspace-manifest::bool?
  (fn (value) ((core/sym::eq? (core/data::tag value)) (quote :bool))))

(def selfhost/pkg-workspace-manifest::optional-string
  (fn (value)
    (fn (limit)
      (fn (label)
        (if (core/list::is-nil? value)
          (selfhost/pkg-workspace-manifest::ok nil)
          (if (((selfhost/pkg-scaffold::bounded-str? value) limit))
            (selfhost/pkg-workspace-manifest::ok value)
            (selfhost/pkg-workspace-manifest::bad label)))))))

(def selfhost/pkg-workspace-manifest::required-string
  (fn (value)
    (fn (limit)
      (fn (label)
        (if (((selfhost/pkg-scaffold::bounded-str? value) limit))
          (if (selfhost/pkg-scaffold::nonempty-str? value)
            (selfhost/pkg-workspace-manifest::ok value)
            (selfhost/pkg-workspace-manifest::bad label))
          (selfhost/pkg-workspace-manifest::bad label))))))

(def selfhost/pkg-workspace-manifest::bounded-string
  (fn (value)
    (fn (limit)
      (fn (label)
        (if (((selfhost/pkg-scaffold::bounded-str? value) limit))
          (selfhost/pkg-workspace-manifest::ok value)
          (selfhost/pkg-workspace-manifest::bad label))))))

(def selfhost/pkg-workspace-manifest::normalize-backend
  (fn (value)
    (if (core/list::is-nil? value)
      (selfhost/pkg-workspace-manifest::ok nil)
      (let ((normalized (selfhost/pkg-workspace-env-select::normalize value)))
        (if (core/list::is-nil? normalized)
          (selfhost/pkg-workspace-manifest::bad
            "runtime_backend must name a supported backend")
          (selfhost/pkg-workspace-manifest::ok normalized))))))

(def selfhost/pkg-workspace-manifest::member
  (fn (value)
    (if (selfhost/pkg-lock-read::map? value)
      (let
        ((name
          (((selfhost/pkg-workspace-manifest::required-string
              ((core/map::get value) "name")) 1024)
            "member name must be a non-empty string"))
          (path
            (((selfhost/pkg-workspace-manifest::required-string
                ((core/map::get value) "path")) 16777216)
              "member path must be a non-empty string"))
          (role
            (((selfhost/pkg-workspace-manifest::optional-string
                ((core/map::get value) "role")) 16777216)
              "member role must be a string")))
        (if ((core/map::get name) (quote :ok))
          (if ((core/map::get path) (quote :ok))
            (if ((core/map::get role) (quote :ok))
              (selfhost/pkg-workspace-manifest::ok
                {
                  :name ((core/map::get name) (quote :value))
                  :path ((core/map::get path) (quote :value))
                  :role ((core/map::get role) (quote :value))})
              role)
            path)
          name))
      (selfhost/pkg-workspace-manifest::bad "workspace member must be a table"))))

(def selfhost/pkg-workspace-manifest::members-loop
  (fn (values)
    (fn (index)
      (fn (state)
        (if ((core/int::eq? index) (core/vec::len values))
          (selfhost/pkg-workspace-manifest::ok state)
          (let ((item (selfhost/pkg-workspace-manifest::member ((core/vec::get values) index))))
            (if ((core/map::get item) (quote :ok))
              (let
                ((member ((core/map::get item) (quote :value)))
                  (name ((core/map::get member) (quote :name)))
                  (path ((core/map::get member) (quote :path))))
                (if
                  (core/list::is-nil?
                    ((core/map::get ((core/map::get state) (quote :names))) name))
                  (if
                    (core/list::is-nil?
                      ((core/map::get ((core/map::get state) (quote :paths))) path))
                    (((selfhost/pkg-workspace-manifest::members-loop values)
                        ((core/int::add index) 1))
                      {
                        :names
                          (((core/map::put ((core/map::get state) (quote :names))) name) true)
                        :paths
                          (((core/map::put ((core/map::get state) (quote :paths))) path) true)
                        :values
                          ((core/vec::push ((core/map::get state) (quote :values))) member)})
                    (selfhost/pkg-workspace-manifest::bad "duplicate workspace member path"))
                  (selfhost/pkg-workspace-manifest::bad "duplicate workspace member name")))
              item)))))))

(def selfhost/pkg-workspace-manifest::members
  (fn (value)
    (if (selfhost/pkg-lock-read::vec? value)
      (if ((core/int::lt? 0) (core/vec::len value))
        (if ((core/int::lt? 4096) (core/vec::len value))
          (selfhost/pkg-workspace-manifest::bad "workspace has too many members")
          (let
            ((result
              (((selfhost/pkg-workspace-manifest::members-loop value) 0)
                {:names {} :paths {} :values []})))
            (if ((core/map::get result) (quote :ok))
              (selfhost/pkg-workspace-manifest::ok
                ((core/map::get ((core/map::get result) (quote :value))) (quote :values)))
              result)))
        (selfhost/pkg-workspace-manifest::bad "members must be non-empty"))
      (selfhost/pkg-workspace-manifest::bad "members must be an array"))))

(def selfhost/pkg-workspace-manifest::defaults
  (fn (value)
    (let ((table (if (core/list::is-nil? value) {} value)))
      (if (selfhost/pkg-lock-read::map? table)
        (let
          ((registry
            (((selfhost/pkg-workspace-manifest::optional-string
                ((core/map::get table) "registry")) 16777216)
              "default registry must be a string"))
            (policy
              (((selfhost/pkg-workspace-manifest::optional-string
                  ((core/map::get table) "policy")) 16777216)
                "default policy must be a string"))
            (toolchain
              (((selfhost/pkg-workspace-manifest::optional-string
                  ((core/map::get table) "toolchain")) 16777216)
                "default toolchain must be a string"))
            (backend
              (selfhost/pkg-workspace-manifest::normalize-backend
                ((core/map::get table) "runtime_backend"))))
          (if ((core/map::get registry) (quote :ok))
            (if ((core/map::get policy) (quote :ok))
              (if ((core/map::get toolchain) (quote :ok))
                (if ((core/map::get backend) (quote :ok))
                  (selfhost/pkg-workspace-manifest::ok
