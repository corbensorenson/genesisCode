(def selfhost/pkg-workspace-manifest::profiles-loop
  (fn (entries)
    (fn (index)
      (fn (out)
        (if ((core/int::eq? index) (core/vec::len entries))
          (selfhost/pkg-workspace-manifest::ok out)
          (let
            ((entry ((core/vec::get entries) index)))
            (let
              ((item
                ((selfhost/pkg-workspace-manifest::profile
                    ((core/vec::get entry) 0))
