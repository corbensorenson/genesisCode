                      :registry ((core/map::get registry) (quote :value))
                      :runtime-backend ((core/map::get backend) (quote :value))
                      :toolchain ((core/map::get toolchain) (quote :value))})
                  backend)
                toolchain)
              policy)
            registry))
        (selfhost/pkg-workspace-manifest::bad "defaults must be a table")))))

(def selfhost/pkg-workspace-manifest::profile
  (fn (name)
    (fn (value)
      (let
        ((valid-name
          (((selfhost/pkg-workspace-manifest::bounded-string name) 1024)
