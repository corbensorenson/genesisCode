      (((selfhost/pkg-workspace-manifest::find-profile-loop profiles) name) 0))))

(def selfhost/pkg-workspace-manifest::normalize
  (fn (document)
    (fn (selected-profile)
      (fn (require-profile)
        (if (selfhost/pkg-lock-read::map? document)
          (let
            ((version ((core/map::get document) "version"))
              (workspace
                (((selfhost/pkg-workspace-manifest::required-string
                    ((core/map::get document) "workspace")) 16777216)
                  "workspace must be a non-empty string"))
              (members
                (selfhost/pkg-workspace-manifest::members
                  ((core/map::get document) "members")))
              (defaults
                (selfhost/pkg-workspace-manifest::defaults
                  ((core/map::get document) "defaults")))
              (profiles
                (selfhost/pkg-workspace-manifest::profiles
                  ((core/map::get document) "profiles")))
              (tasks
                (selfhost/pkg-workspace-manifest::tasks
                  ((core/map::get document) "tasks"))))
            (if
              (if (selfhost/pkg-lock-read::int? version)
                ((core/int::eq? version) 1)
                false)
              (if ((core/map::get workspace) (quote :ok))
                (if ((core/map::get members) (quote :ok))
                  (if ((core/map::get defaults) (quote :ok))
                    (if ((core/map::get profiles) (quote :ok))
                      (if ((core/map::get tasks) (quote :ok))
                        (let
                          ((profile
                            ((selfhost/pkg-workspace-manifest::find-profile
                                ((core/map::get profiles) (quote :value)))
                              selected-profile)))
                          (if (if require-profile (core/list::is-nil? profile) false)
                            (selfhost/pkg-workspace-manifest::bad
                              "required workspace profile was not found")
                            (selfhost/pkg-workspace-manifest::ok
                              {
                                :defaults ((core/map::get defaults) (quote :value))
                                :members ((core/map::get members) (quote :value))
                                :profiles ((core/map::get profiles) (quote :value))
                                :selected-profile profile
                                :tasks ((core/map::get tasks) (quote :value))
                                :version 1
                                :workspace ((core/map::get workspace) (quote :value))})))
                        tasks)
                      profiles)
                    defaults)
                  members)
                workspace)
              (selfhost/pkg-workspace-manifest::bad
                "workspace version must be exactly 1")))
          (selfhost/pkg-workspace-manifest::bad "workspace document must be a table"))))))
