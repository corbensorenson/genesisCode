(def selfhost/pkg-workspace-manifest::find-profile-loop
  (fn (profiles)
    (fn (name)
      (fn (index)
        (if ((core/int::eq? index) (core/vec::len profiles))
          nil
          (let ((profile ((core/vec::get profiles) index)))
            (if ((core/eq? ((core/map::get profile) (quote :name))) name)
              profile
              (((selfhost/pkg-workspace-manifest::find-profile-loop profiles) name)
                ((core/int::add index) 1)))))))))

(def selfhost/pkg-workspace-manifest::find-profile
  (fn (profiles)
