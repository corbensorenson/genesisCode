(def selfhost/pkg-workspace-manifest::task
  (fn (name)
    (fn (value)
      (let
        ((valid-name
          (((selfhost/pkg-workspace-manifest::bounded-string name) 1024)
            "task name must be a string")))
        (if ((core/map::get valid-name) (quote :ok))
          (if (selfhost/pkg-lock-read::map? value)
            (let
              ((cmd
                (((selfhost/pkg-workspace-manifest::required-string
                    ((core/map::get value) "cmd")) 16777216)
