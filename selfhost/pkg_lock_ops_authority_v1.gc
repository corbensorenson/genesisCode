(def selfhost/pkg-lock-ops::list
  (fn (request-h)
    (fn (document)
      (let ((normalized (selfhost/pkg-lock-read::normalize-model-document document)))
        (if ((core/map::get normalized) (quote :ok))
          (let ((model ((core/map::get normalized) (quote :value))))
