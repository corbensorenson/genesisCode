            (((selfhost/pkg-lock-ops::reject request-h) "core/pkg/bad-authority-request")
              "request :op must be :add or :list")))))))

(def core/pkg::lock-ops-authority
  (fn (request)
    (let ((request-h (selfhost/hash::hash-term request)))
      (if (selfhost/pkg-lock-read::map? request)
        (if
          ((selfhost/pkg-lock-read::exact-map? request)
            [
              :document
              :kind
              :op
              :payload
              :v])
          (let ((kind ((core/map::get request) (quote :kind))))
            (if
              (if (selfhost/pkg-lock-read::str? kind)
                ((core/eq? kind) "genesis/pkg-lock-ops-authority-request-v0.1")
                false)
              (let ((version ((core/map::get request) (quote :v))))
                (if (if (selfhost/pkg-lock-read::int? version) ((core/int::eq? version) 1) false)
                  ((selfhost/pkg-lock-ops::dispatch request-h) request)
                  (((selfhost/pkg-lock-ops::reject request-h) "core/pkg/bad-authority-request")
                    "request :v must be 1")))
              (((selfhost/pkg-lock-ops::reject request-h) "core/pkg/bad-authority-request")
                "request :kind mismatch")))
          (((selfhost/pkg-lock-ops::reject request-h) "core/pkg/bad-authority-request")
            "request fields mismatch"))
        (((selfhost/pkg-lock-ops::reject request-h) "core/pkg/bad-authority-request")
          "request must be map")))))
