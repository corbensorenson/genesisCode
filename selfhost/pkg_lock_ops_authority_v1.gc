(def selfhost/pkg-lock-ops::add-to-model
  (fn (request-h)
    (fn (model)
      (fn (payload)
        (let ((name ((core/map::get payload) (quote :name))))
          (let ((selector ((core/map::get payload) (quote :selector))))
            (if
              (if (selfhost/pkg-lock-read::str? name) (selfhost/pkg-lock-read::str? selector) false)
              (let
                (
                  (update-policy
                    (selfhost/pkg-lock-write::normalize-update-policy
                      ((core/map::get payload) (quote :update-policy)))))
                (if (selfhost/pkg-lock-read::nil? update-policy)
                  (((selfhost/pkg-lock-ops::reject request-h) "core/pkg/bad-payload")
                    ":update-policy must be 'manual' or 'auto'")
                  (let
                    (
                      (strategy
                        ((selfhost/pkg-lock-write::normalize-strategy ((core/map::get payload) (quote :strategy)))
                          selector)))
                    (if (selfhost/pkg-lock-read::nil? strategy)
                      (((selfhost/pkg-lock-ops::reject request-h) "core/pkg/bad-payload")
                        ":strategy must be pinned, track-ref, or tag-policy")
                      (let ((tag-policy ((core/map::get payload) (quote :tag-policy))))
                        (if (selfhost/pkg-lock-read::valid-optional-string? tag-policy)
                          (let
                            (
                              (effective-tag
                                (if ((core/eq? strategy) "tag-policy")
                                  (if (selfhost/pkg-lock-read::nil? tag-policy) "exact" tag-policy)
                                  nil)))
                            (let ((registry0 ((core/map::get payload) (quote :registry))))
                              (let
                                (
                                  (requirement
                                    {
                                      :registry
                                        (if (selfhost/pkg-lock-read::str? registry0) registry0 nil)
                                      :selector selector
                                      :strategy strategy
                                      :tag-policy effective-tag
                                      :update-policy update-policy}))
                                (let
                                  ((requirements (((core/map::put ((core/map::get model) (quote :requirements))) name) requirement)))
                                  ((selfhost/pkg-lock-ops::render-model request-h)
                                    (((core/map::put model) (quote :requirements)) requirements))))))
                          (((selfhost/pkg-lock-ops::reject request-h) "core/pkg/bad-payload")
                            ":tag-policy must be string or nil")))))))
              (((selfhost/pkg-lock-ops::reject request-h) "core/pkg/bad-payload")
                "missing :name or :selector string"))))))))

(def selfhost/pkg-lock-ops::add
  (fn (request-h)
    (fn (document)
      (fn (payload)
        (if (selfhost/pkg-lock-read::map? payload)
          (let ((normalized (selfhost/pkg-lock-read::normalize-model-document document)))
            (if ((core/map::get normalized) (quote :ok))
              (((selfhost/pkg-lock-ops::add-to-model request-h) ((core/map::get normalized) (quote :value)))
                payload)
              (((selfhost/pkg-lock-ops::reject request-h) "core/pkg/bad-lock")
                ((core/map::get normalized) (quote :message)))))
          (((selfhost/pkg-lock-ops::reject request-h) "core/pkg/bad-payload")
            "payload must be a map"))))))

(def selfhost/pkg-lock-ops::list-requirements-loop
  (fn (entries)
    (fn (index)
      (fn (out)
        (if ((core/int::eq? index) (core/vec::len entries))
          out
          (let ((entry ((core/vec::get entries) index)))
            (let ((name ((core/vec::get entry) 0)))
              (let ((requirement ((core/vec::get entry) 1)))
                (((selfhost/pkg-lock-ops::list-requirements-loop entries) ((core/int::add index) 1))
                  ((core/vec::push out)
                    {
                      :name name
                      :registry ((core/map::get requirement) (quote :registry))
                      :selector ((core/map::get requirement) (quote :selector))
                      :strategy ((core/map::get requirement) (quote :strategy))
                      :tag-policy ((core/map::get requirement) (quote :tag-policy))
