(def selfhost/pkg-lock-ops::writer-locked-loop
  (fn (entries)
    (fn (index)
      (fn (out)
        (if ((core/int::eq? index) (core/vec::len entries))
          out
          (let ((entry ((core/vec::get entries) index)))
            (let ((name ((core/vec::get entry) 0)))
              (((selfhost/pkg-lock-ops::writer-locked-loop entries) ((core/int::add index) 1))
                (((core/map::put out) name)
                  (selfhost/pkg-lock-ops::writer-locked-entry ((core/vec::get entry) 1)))))))))))

(def selfhost/pkg-lock-ops::writer-locked
  (fn (locked) (((selfhost/pkg-lock-ops::writer-locked-loop (core/map::entries locked)) 0) {})))

(def selfhost/pkg-lock-ops::writer-payload
