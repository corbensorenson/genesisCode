            ((core/map::get normalized) (quote :message))))))))

(def selfhost/pkg-lock-ops::dispatch
  (fn (request-h)
    (fn (request)
      (let ((op ((core/map::get request) (quote :op))))
        (if ((core/sym::eq? op) (quote :add))
