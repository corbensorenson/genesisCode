(def selfhost/pkg-lock-ops::render-payload
  (fn (request-h)
    (fn (payload)
      (let ((rendered (selfhost/pkg-lock-write::render-lock payload)))
        (let ((error ((core/map::get rendered) (quote :error))))
          (if (selfhost/pkg-lock-read::nil? error)
            ((selfhost/pkg-lock-ops::accept-write request-h)
              (core/str::to-utf8 ((core/map::get rendered) (quote :text))))
