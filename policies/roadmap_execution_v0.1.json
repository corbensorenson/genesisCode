    "wip_limit": 1,
    "scope_freeze": {
      "until_task_id": "R9.4.f",
      "frozen_program_concepts": [
        "GenesisCode",
        "GenesisBench",
        "GenesisChallenge",
        "Genesis Foundry",
        "Genesis Model"
      ],
      "forbidden_addition_classes": [
