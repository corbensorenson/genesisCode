        "research-lane",
        "milestone-family",
        "task-family",
        "governed-gate-family"
      ],
      "exception_rule": "Only a reproduced P0/P1 correction may replace one equivalent concept one-for-one with a recorded deletion, dependency impact, acceptance delta, and no increase in WIP or release ancestry."
    },
    "ordered_task_ids": [
      "R0.4.j",
      "R2.2.f",
      "R1.3.f",
      "R1.5.a",
      "R1.6.a",
      "R1.7.a",
      "R2.1.h",
      "R2.3.a",
      "R4.1.a"
    ],
    "rationale": "Close P1.7 and P1.6 through reopened R0.4.j, ordering generated-publication resource ownership and the complete R0.4.i/R0.4.k guard rerun before exact-main standard/full evidence; close P1.5 and R2.2.f next; then advance the complete sequential R1.3, R1.5, R1.6, R1.7, R2.1, and R2.3 agent/runtime frontier before SH-A establishes self-host semantic ownership. Carry the finite Core through exact reviewed R9.4.f before reactivating any GenesisBench campaign, custody, publication, governance, GenesisChallenge, Foundry implementation, or Genesis Model work.",
    "task_context": {
      "R0.4.j": {
        "product_lanes": ["GenesisCode"],
        "milestones": ["M0", "M1-A", "M1-B"],
        "nonclaims": [
          "does not treat generated output, update execution, or mutable telemetry as independent evidence",
          "does not close R0.4.j until exact-main standard/full evidence is independently watched"
        ]
      },
      "R2.2.f": {
        "product_lanes": ["GenesisCode"],
        "milestones": ["M1-A", "M2"],
        "nonclaims": [
          "does not close daemon or service readiness until every supported-host lifecycle matrix passes",
          "does not downgrade a promised hard-cancellation guarantee to cooperative cancellation",
          "does not discard stop, join, reap, or residual-process failures behind an initiating operation error"
        ]
      },
      "R1.3.f": {
        "product_lanes": ["GenesisCode"],
        "milestones": ["M1-A"],
        "nonclaims": [
          "does not convert local mutable performance observations into release evidence",
          "does not authorize a GenesisBench campaign or Genesis Model dependency"
        ]
      },
      "R1.5.a": {
        "product_lanes": ["GenesisCode"],
        "milestones": ["M1-A"],
        "nonclaims": [
          "does not grant authority from generated cards, documentation, prompts, or model output",
          "does not claim clean-install or cross-model distribution until the complete R1.5 sequence passes"
        ]
      },
      "R2.1.h": {
        "product_lanes": ["GenesisCode"],
        "milestones": ["M2"],
        "nonclaims": [
          "does not close Runtime Beta without the remaining R2 and R3 parity and budget gates",
          "does not loosen deterministic resource ceilings to meet performance targets"
        ]
      },
      "R1.6.a": {
        "product_lanes": ["GenesisCode"],
        "milestones": ["M1-A"],
        "nonclaims": [
          "does not grant candidates live-state or verification authority",
          "does not create a second VCS, patch engine, or content store"
        ]
      },
      "R1.7.a": {
        "product_lanes": ["GenesisCode"],
        "milestones": ["M1-A"],
        "nonclaims": [
          "does not treat English or model output as executable authority",
          "does not require or authorize a Genesis Model"
        ]
      },
      "R2.3.a": {
        "product_lanes": ["GenesisCode"],
        "milestones": ["M2"],
        "nonclaims": [
          "does not claim PB-6 until cold and warm startup evidence passes",
          "does not make cached or host-specific state part of canonical semantics"
        ]
      },
      "R4.1.a": {
        "product_lanes": ["GenesisCode"],
        "milestones": ["M3", "M5-C", "M6"],
        "nonclaims": [
          "does not establish self-host closure without H2 production authority and H3 bootstrap evidence",
          "does not broaden stage0 or authorize GenesisBench, Foundry, or Genesis Model work"
        ]
      }
    },
    "allowed_parallel_lanes": [
      {
        "id": "read-only-selfhost-assurance",
        "description": "One read-only, independently custodied conformance or reproduction observation may run beside the GenesisCode production task.",
        "conditions": [
          "it cannot modify repository files, generated authorities, release state, or the active production transaction",
          "it exercises only frozen GenesisCode inputs and independently reports pass, fail, unknown, or infrastructure failure",
          "it performs no target-model inference, benchmark custody or commissioning, result publication, Foundry implementation, or Genesis Model work",
          "it cannot authorize completion, promotion, capability, policy, signing, or release"
        ]
      },
      {
        "id": "model-interface-portability-canary",
        "description": "One read-only, non-scoring local canary may test whether a materially different model family crosses the transport-neutral interface without provider imitation.",
        "conditions": [
          "it runs only after model-free adapter fixtures pass and uses an already inventoried digest-pinned local model plus a direct-runtime or generic JSON-stdio stack",
          "it receives fixed protocol canary content only and no GenesisBench task, private payload, scorer, answer, repair loop, tool authority, or language-change signal",
          "it cannot modify repository files, generated authorities, release state, benchmark custody, or the active production transaction",
          "it emits only pass, fail, unsupported, or infrastructure-failure with exact model, runtime, adapter, input, output, cancellation, cleanup, and transcript identities",
          "it creates no benchmark attempt, score, cohort, rank, result, adoption claim, task completion, capability, policy, signing, publication, or release authority"
        ]
      }
    ]
  },
