      "minimumSamplesPerState": 3,
      "oddSamplesRequired": true,
      "repeatPolicy": "independent-matched-cohorts"
    },
    {
      "cacheStates": [
        "not-measured"
      ],
      "dependencies": [
        "setup/evidence-bundle"
      ],
      "id": "invariant",
      "isolation": "owned-ephemeral-root",
      "minimumSamplesPerState": 1,
      "oddSamplesRequired": true,
      "repeatPolicy": "exactly-once"
    },
    {
      "cacheStates": [
        "not-measured"
      ],
      "dependencies": [
        "setup/evidence-bundle"
      ],
      "id": "stress-performance",
      "isolation": "exclusive-owned-ephemeral-root",
      "minimumSamplesPerState": 3,
      "oddSamplesRequired": true,
      "repeatPolicy": "independent-odd-cohort"
    }
  ],
  "fanout": {
    "consumers": [
      "invariant",
      "stress-performance"
    ],
    "crossRunReuseAllowed": false,
    "producer": "setup/evidence-bundle",
    "sameRunOnly": true,
    "sourceSample": {
      "class": "cold",
      "index": 1
    }
  },
