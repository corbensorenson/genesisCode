  "profile": "release-full",
  "version": "0.2.0",
  "warmPrecondition": {
    "artifactInventoryMustMatch": true,
    "cacheKeyMustMatch": true,
    "featureSetMustMatch": true,
    "measured": false,
    "network": "deny",
    "ownedEmptyRootRequired": true,
    "sourceMustMatch": true,
    "toolchainMustMatch": true
  },
  "watchdog": {
    "authority": "independent",
    "freshnessSeconds": 172800,
    "fullRunDeadlineSeconds": 3600,
    "latestMainStandardDeadlineSeconds": 7200,
    "selfReportingAllowed": false
  }
