{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://genesiscodelang.dev/spec/SELFHOST_OBLIGATION_AUTHORITY_v0.1.schema.json",
  "title": "GenesisCode self-host obligation authority profile v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact",
    "auditDate",
    "binding",
    "contentIdentitySha256",
    "hostFacts",
    "independentVerifier",
    "kind",
    "migratedObligations",
    "nonclaims",
    "productionEntrypoints",
    "residualObligations",
    "resultKind",
    "runtimeEvidence",
    "schema",
    "sourceModules",
    "sourceSetSha256",
    "spec",
    "version"
  ],
  "properties": {
    "artifact": {"const": "selfhost/toolchain.gc"},
    "auditDate": {"type": "string", "format": "date"},
    "binding": {"const": "core/cli::obligation-authority"},
    "contentIdentitySha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "hostFacts": {
      "const": ["actual-value-hash", "canonical-module-forms", "effect-entry-count", "effect-log-artifact", "effect-log-byte-count", "expected-value-hash", "module-path", "observed-effect-operation", "sealed-error-status", "step-count", "test-identity"]
    },
    "independentVerifier": {"const": "scripts/lib/selfhost_obligation_authority.py"},
    "kind": {"const": "genesis/selfhost-obligation-authority-v0.1"},
    "migratedObligations": {"const": ["core/obligation::budgets", "core/obligation::capabilities-declared", "core/obligation::typecheck", "core/obligation::typecheck-strict", "core/obligation::unit-tests"]},
    "nonclaims": {"type": "array", "minItems": 8, "uniqueItems": true, "items": {"type": "string"}},
    "productionEntrypoints": {"const": ["genesis", "genesis_wasi"]},
    "residualObligations": {"type": "array", "minItems": 15, "maxItems": 15, "uniqueItems": true, "items": {"type": "string"}},
    "resultKind": {"const": "genesis/obligation-authority-result-v0.2"},
    "runtimeEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allocationLimit", "stepLimit", "timeoutSeconds"],
      "properties": {
        "allocationLimit": {"const": 5000000},
        "stepLimit": {"const": 5000000},
        "timeoutSeconds": {"const": 60}
      }
    },
    "schema": {"const": "docs/spec/SELFHOST_OBLIGATION_AUTHORITY_v0.1.schema.json"},
    "sourceModules": {"const": ["selfhost/obligation_authority_core_v1.gc", "selfhost/obligation_authority_typecheck_v1.gc", "selfhost/obligation_authority_v1.gc"]},
    "sourceSetSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "spec": {"const": "docs/spec/SELFHOST_OBLIGATION_AUTHORITY_v0.1.md"},
    "version": {"const": "0.1.0"}
  }
}
