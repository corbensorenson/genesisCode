{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://genesiscode.dev/schemas/selfhost-commit-authority-v0.1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact", "auditDate", "binding", "contentIdentitySha256", "decisionInventory",
    "hostMechanisms", "hostOracle", "independentVerifier", "kind", "nonclaims",
    "productionEntrypoints", "requestKind", "resultKind", "schema", "sourceModule",
    "sourceSha256", "spec", "version"
  ],
  "properties": {
    "artifact": {"const": "selfhost/toolchain.gc"},
    "auditDate": {"type": "string", "format": "date"},
    "binding": {"const": "core/commit::authority"},
    "contentIdentitySha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "decisionInventory": {"const": [
      "native-commit-object-construction", "native-commit-object-field-closure",
      "native-commit-object-identity-admission", "native-commit-object-inspection-admission",
      "native-commit-author-metadata-construction", "vcs-history-commit-object-admission",
      "request-bound-result-verdict"
    ]},
    "hostMechanisms": {"const": [
      "artifact-only-authority-bootstrap-and-bounded-evaluation", "cli-argument-transport",
      "ref-and-store-mechanisms", "patch-application-mechanism",
      "artifact-hash-contradiction-check", "diagnostic-rendering"
    ]},
    "hostOracle": {
      "type": "object", "additionalProperties": false,
      "required": ["parityOnly", "productionRequired", "removalTask"],
      "properties": {
        "parityOnly": {"const": true}, "productionRequired": {"const": false},
        "removalTask": {"const": "R4.2.e"}
      }
    },
    "independentVerifier": {"const": "scripts/lib/selfhost_commit_authority.py"},
    "kind": {"const": "genesis/selfhost-commit-authority-v0.1"},
    "nonclaims": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "productionEntrypoints": {"const": ["genesis"]},
    "requestKind": {"const": "genesis/commit-authority-request-v0.1"},
    "resultKind": {"const": "genesis/commit-authority-result-v0.1"},
    "schema": {"const": "docs/spec/SELFHOST_COMMIT_AUTHORITY_v0.1.schema.json"},
    "sourceModule": {"const": "selfhost/commit_authority_v1.gc"},
    "sourceSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "spec": {"const": "docs/spec/SELFHOST_COMMIT_AUTHORITY_v0.1.md"},
    "version": {"const": "0.1.0"}
  }
}
